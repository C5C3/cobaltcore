@@ -36,9 +38,41 @@ from cinder.tests.unit import test
 from cinder.tests.unit import utils
 from cinder.tests.unit.volume.flows import fake_volume_api
 from cinder.volume.flows.api import create_volume
+from cinder.volume.flows import common as flow_common
 from cinder.volume.flows.manager import create_volume as create_volume_manager
 
 
+class VolumeCreateLostDatabaseTestCase(test.TestCase):
+
+    @mock.patch.object(create_volume_manager.common, 'error_out')
+    def test_revert_sets_error_on_a_lost_database(self, mock_error_out):
+        task = create_volume_manager.ExtractVolumeRefTask(
+            mock.sentinel.db, 'host', set_error=False)
+        result = ft.Failure.from_exception(
+            db_exc.DBConnectionError(Exception('gone')))
+        volume = mock.MagicMock()
+        task.revert(mock.sentinel.context, volume, result)
+        mock_error_out.assert_called_once_with(volume, mock.ANY)
+
+    @mock.patch.object(create_volume_manager.common, 'error_out')
+    def test_revert_keeps_a_volume_that_is_gone(self, mock_error_out):
+        task = create_volume_manager.ExtractVolumeRefTask(
+            mock.sentinel.db, 'host', set_error=False)
+        result = ft.Failure.from_exception(
+            exception.VolumeNotFound(volume_id=fakes.VOLUME_ID))
+        task.revert(mock.sentinel.context, mock.sentinel.volume, result)
+        mock_error_out.assert_not_called()
+
+    @mock.patch('tenacity.nap.sleep')
+    def test_error_out_waits_for_the_database(self, _mock_sleep):
+        volume = mock.MagicMock()
+        volume.save.side_effect = [
+            db_exc.DBConnectionError(Exception('gone')), None]
+        flow_common.error_out(volume)
+        self.assertEqual('error', volume.status)
+        self.assertEqual(2, volume.save.call_count)
+
+
 @ddt.ddt
 class CreateVolumeFlowTestCase(test.TestCase):
 
diff --git a/cinder/volume/flows/common.py b/cinder/volume/flows/common.py
index 10e60df..b8f4cc2 100644
--- a/cinder/volume/flows/common.py
+++ b/cinder/volume/flows/common.py
@@ -18,9 +18,11 @@
 
 from typing import Callable
 
+from oslo_db import exception as db_exc
 from oslo_log import log as logging
 
 from cinder import exception
+from cinder import utils
 
 LOG = logging.getLogger(__name__)
 
@@ -74,6 +76,15 @@ def _clean_reason(reason):
         return reason[0:REASON_LENGTH] + '...'
 
 
+# NOTE: The waits add up to 254 seconds, which outlasts a database failover. A
+# status that never lands leaves the resource in its transient state, where it
+# cannot be deleted until the service restarts.
+@utils.retry(db_exc.DBConnectionError, interval=2, retries=8, backoff_rate=2)
+def _save_status(resource, status):
+    resource.status = status
+    resource.save()
+
+
 def error_out(resource, reason=None, status='error'):
     """Sets status to error for any persistent OVO."""
     reason = _clean_reason(reason)
@@ -82,8 +93,7 @@ def error_out(resource, reason=None, status='error'):
                   '%(reason)s', {'object_type': resource.obj_name(),
                                  'object_id': resource.id,
                                  'reason': reason})
-        resource.status = status
-        resource.save()
+        _save_status(resource, status)
     except Exception:
         # Don't let this cause further exceptions.
         LOG.exception("Failed setting %(object_type)s %(object_id)s to "
