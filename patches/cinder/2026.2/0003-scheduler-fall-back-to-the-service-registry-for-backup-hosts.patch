@@ -1060,6 +1063,36 @@ class HostManager(object):
 
         return services
 
+    def _list_registered_backup_services(self, availability_zone) -> list:
+        """List the backup services the service registry holds as up.
+
+        A backup service reports its capabilities to the scheduler over an
+        RPC fanout: once from init_host, then every
+        backup_driver_stats_polling_interval seconds. A scheduler that
+        starts in the same second as the backup service misses the first
+        report, and a first report sent while the backup driver is still
+        initializing carries backend_state False. Either way the scheduler
+        holds no usable backup service until the next report, up to a
+        minute later, and answers every backup in between with
+        ServiceNotFound although the service is up.
+
+        The service registry is what restore and delete read to find a
+        backup service, and what the scheduler read before the capability
+        reports existed, so it is the fallback while no report names a
+        ready service. A service whose driver never initializes stops
+        sending heartbeats and drops out of the registry after
+        service_down_time.
+        """
+        ctxt = cinder_context.get_admin_context()
+        services = objects.ServiceList.get_all_by_topic(
+            ctxt, constants.BACKUP_TOPIC, disabled=False)
+        hosts = [srv.cluster_name or srv.host for srv in services
+                 if self._az_matched(srv, availability_zone) and srv.is_up]
+        if hosts:
+            LOG.info("No backup service has reported itself ready yet, "
+                     "falling back to the service registry: %s", hosts)
+        return hosts
+
     def _az_matched(self,
                     service: objects.Service,
                     availability_zone: Optional[str]) -> bool:
