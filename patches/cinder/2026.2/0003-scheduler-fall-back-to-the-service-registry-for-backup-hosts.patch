+    def _backup_service(self, host, **updates):
+        values = dict(host=host, binary='cinder-backup', topic='cinder-backup',
+                      availability_zone='zone1', cluster_name=None,
+                      updated_at=timeutils.utcnow())
+        values.update(updates)
+        return fake_service.fake_service_obj(context.get_admin_context(),
+                                             **values)
+
+    @mock.patch('cinder.objects.ServiceList.get_all_by_topic')
+    def test_backup_host_from_capability_report(self, mock_get_all):
+        self.host_manager.backup_service_states['host-a'] = {
+            'backend_state': True, 'driver_name': 'fake',
+            'availability_zone': 'zone1'}
+
+        host = self.host_manager._get_available_backup_service_host(
+            None, 'zone1')
+
+        self.assertEqual('host-a', host)
+        mock_get_all.assert_not_called()
+
+    @mock.patch('cinder.objects.ServiceList.get_all_by_topic')
+    def test_backup_host_falls_back_to_registry(self, mock_get_all):
+        self.host_manager.backup_service_states = {}
+        down = timeutils.utcnow() - timedelta(
+            seconds=cfg.CONF.service_down_time + 10)
+        mock_get_all.return_value = [
+            self._backup_service('host-a'),
+            self._backup_service('host-b', availability_zone='zone2'),
+            self._backup_service('host-c', updated_at=down),
