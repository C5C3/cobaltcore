 from nova.accelerator import cyborg
 from nova import block_device
@@ -1635,6 +1637,37 @@ def delete_arqs_if_needed(context, instance, arq_uuids=None):
         cyclient.delete_arqs_by_uuid(arq_uuids)
 
 
+def _is_transient_cinder_failure(exc):
+    """True for a failure of Cinder that a later attempt can outlast."""
+    if isinstance(exc, exception.CinderConnectionFailed):
+        return True
+    return (isinstance(exc, cinder_exception.ClientException) and
+            getattr(exc, 'code', None) in (500, 502, 503, 504))
+
+
+# NOTE: The waits add up to 254 seconds, which outlasts a database failover of
+# Cinder. The callers clean up after a failed attach or detach: the attachment
+# of a failed attach, which no block device mapping refers to any more, and the
+# detaching status of a failed detach. A call that gives up leaves the volume
+# reserved, attaching or detaching, where Cinder refuses to delete it and Nova
+# to detach it.
+@retrying.retry(retry_on_exception=_is_transient_cinder_failure,
+                wait_exponential_multiplier=1000,
+                wait_exponential_max=128000,
+                stop_max_attempt_number=8)
+def call_cinder_with_retries(call, *args, **kwargs):
+    """Call a cinder API method, waiting out a transient failure of Cinder.
+
+    A 5xx or a connection failure is retried; every other error, such as
+    VolumeAttachmentNotFound, goes to the caller.
+
+    :param call: the method of nova.volume.cinder.API to call
+    :param args: its positional arguments
+    :param kwargs: its keyword arguments
+    """
+    return call(*args, **kwargs)
+
+
 def check_attach_and_reserve_volume(context, volume_api, volume, instance,
                                     bdm, supports_multiattach=False,
                                     validate_az=True):
