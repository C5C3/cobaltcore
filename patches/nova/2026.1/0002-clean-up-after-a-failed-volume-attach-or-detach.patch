+@mock.patch('retrying.time.sleep')
+class CallCinderWithRetriesTestCase(test.NoDBTestCase):
+    def setUp(self):
+        super().setUp()
+        self.context = context.get_admin_context()
+        self.volume_api = mock.MagicMock(spec=cinder.API)
+
+    @staticmethod
+    def _waits(mock_sleep):
+        # The patch replaces time.sleep, which other code calls with 0.
+        return [c.args[0] for c in mock_sleep.call_args_list if c.args[0]]
+
+    def _delete(self):
+        compute_utils.call_cinder_with_retries(
+            self.volume_api.attachment_delete, self.context,
+            uuids.attachment_id)
+
+    def test_call_cinder_with_retries(self, mock_sleep):
+        self._delete()
+        self.volume_api.attachment_delete.assert_called_once_with(
+            self.context, uuids.attachment_id)
+        self.assertEqual([], self._waits(mock_sleep))
+
+    def test_call_cinder_with_retries_waits_for_cinder(self, mock_sleep):
+        self.volume_api.attachment_delete.side_effect = [
+            cinder_exception.ClientException(500),
+            exception.CinderConnectionFailed(reason='gone'),
+            cinder_exception.ClientException(503),
+            None]
+        self._delete()
+        self.assertEqual(4, self.volume_api.attachment_delete.call_count)
+        self.assertEqual([2.0, 4.0, 8.0], self._waits(mock_sleep))
+
+    def test_call_cinder_with_retries_gives_up(self, mock_sleep):
+        self.volume_api.attachment_delete.side_effect = (
+            cinder_exception.ClientException(500))
+        self.assertRaises(cinder_exception.ClientException, self._delete)
+        self.assertEqual(8, self.volume_api.attachment_delete.call_count)
+        self.assertEqual(254, sum(self._waits(mock_sleep)))
+
+    def test_call_cinder_with_retries_not_found(self, mock_sleep):
+        self.volume_api.attachment_delete.side_effect = (
+            exception.VolumeAttachmentNotFound(
+                attachment_id=uuids.attachment_id))
+        self.assertRaises(exception.VolumeAttachmentNotFound, self._delete)
+        self.volume_api.attachment_delete.assert_called_once_with(
+            self.context, uuids.attachment_id)
+        self.assertEqual([], self._waits(mock_sleep))
+
+    def test_call_cinder_with_retries_does_not_retry_a_rejection(
+            self, mock_sleep):
+        self.volume_api.attachment_delete.side_effect = (
+            exception.InvalidInput(reason='no'))
+        self.assertRaises(exception.InvalidInput, self._delete)
+        self.volume_api.attachment_delete.assert_called_once_with(
+            self.context, uuids.attachment_id)
+        self.assertEqual([], self._waits(mock_sleep))
