+@mock.patch('retrying.time.sleep')
+class CallWithDBRetriesTestCase(test.NoDBTestCase):
+    def setUp(self):
+        super().setUp()
+        self.call = mock.Mock(return_value=mock.sentinel.result)
+
+    @staticmethod
+    def _waits(mock_sleep):
+        # The patch replaces time.sleep, which other code calls with 0.
+        return [c.args[0] for c in mock_sleep.call_args_list if c.args[0]]
+
+    @staticmethod
+    def _lost_database():
+        return messaging.RemoteError('DBConnectionError', 'gone', '')
+
+    def _call(self):
+        return compute_utils.call_with_db_retries(
+            self.call, mock.sentinel.instance, clean_task_state=True)
+
+    def test_call_with_db_retries(self, mock_sleep):
+        self.assertEqual(mock.sentinel.result, self._call())
+        self.call.assert_called_once_with(
+            mock.sentinel.instance, clean_task_state=True)
+        self.assertEqual([], self._waits(mock_sleep))
+
+    @mock.patch.object(compute_utils.LOG, 'warning')
+    def test_call_with_db_retries_waits_for_the_database(
+            self, mock_warning, mock_sleep):
+        self.call.side_effect = [
+            self._lost_database(), self._lost_database(),
+            self._lost_database(), None]
+        self._call()
+        self.assertEqual(4, self.call.call_count)
+        self.assertEqual([2.0, 4.0, 8.0], self._waits(mock_sleep))
+        self.assertEqual(
+            [mock.call('Database unreachable through nova-conductor: %s',
+                       'gone')] * 3,
+            mock_warning.call_args_list)
+
+    def test_call_with_db_retries_gives_up(self, mock_sleep):
+        self.call.side_effect = self._lost_database()
+        self.assertRaises(messaging.RemoteError, self._call)
+        self.assertEqual(19, self.call.call_count)
+        # 254 seconds in all, and no wait longer than 16 seconds.
+        self.assertEqual([2.0, 4.0, 8.0] + [16.0] * 15,
+                         self._waits(mock_sleep))
+
+    def test_call_with_db_retries_does_not_retry_other_remote_errors(
+            self, mock_sleep):
+        self.call.side_effect = messaging.RemoteError('ValueError', 'no', '')
+        self.assertRaises(messaging.RemoteError, self._call)
+        self.call.assert_called_once_with(
+            mock.sentinel.instance, clean_task_state=True)
+        self.assertEqual([], self._waits(mock_sleep))
+
+    def test_call_with_db_retries_does_not_retry_a_timeout(self, mock_sleep):
+        self.call.side_effect = messaging.MessagingTimeout()
+        self.assertRaises(messaging.MessagingTimeout, self._call)
+        self.call.assert_called_once_with(
+            mock.sentinel.instance, clean_task_state=True)
+        self.assertEqual([], self._waits(mock_sleep))
+
+    def test_call_with_db_retries_does_not_retry_a_local_error(
+            self, mock_sleep):
+        self.call.side_effect = exception.InstanceNotFound(
+            instance_id=uuids.instance)
+        self.assertRaises(exception.InstanceNotFound, self._call)
+        self.call.assert_called_once_with(
+            mock.sentinel.instance, clean_task_state=True)
+        self.assertEqual([], self._waits(mock_sleep))
