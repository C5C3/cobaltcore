diff --git a/nova/compute/utils.py b/nova/compute/utils.py
index 2e97742..2b3817b 100644
--- a/nova/compute/utils.py
+++ b/nova/compute/utils.py
@@ -24,6 +24,7 @@ import traceback
 
 from cinderclient import exceptions as cinder_exception
 from oslo_log import log
+import oslo_messaging as messaging
 from oslo_serialization import jsonutils
 from oslo_utils import excutils
 import psutil
@@ -1668,6 +1669,46 @@ def call_cinder_with_retries(call, *args, **kwargs):
     return call(*args, **kwargs)
 
 
+def _is_lost_database(exc):
+    """True when nova-conductor could not reach its database.
+
+    Logs a warning for every such error, so each attempt of
+    call_with_db_retries that meets a lost database shows in the log.
+    """
+    if (isinstance(exc, messaging.RemoteError) and
+            exc.exc_type == 'DBConnectionError'):
+        LOG.warning('Database unreachable through nova-conductor: %s',
+                    exc.value)
+        return True
+    return False
+
+
+# NOTE: The waits add up to 254 seconds, the bound of call_cinder_with_retries,
+# which outlasts a database failover. The caller is
+# ComputeManager.terminate_instance, whose write of the ERROR state after a
+# failed delete is the one that ends the task state deleting: the API ignores
+# every later delete while the server keeps it. Each wait holds the instance
+# lock and one RPC worker of nova-compute, so the waits stop growing at 16
+# seconds: once the database is back, the next attempt follows within 16
+# seconds.
+@retrying.retry(retry_on_exception=_is_lost_database,
+                wait_exponential_multiplier=1000,
+                wait_exponential_max=16000,
+                stop_max_attempt_number=19)
+def call_with_db_retries(call, *args, **kwargs):
+    """Call a method that writes through nova-conductor, waiting out a lost
+    database.
+
+    A lost database is retried for up to 254 seconds; every other error goes
+    to the caller on the first attempt.
+
+    :param call: the method to call
+    :param args: its positional arguments
+    :param kwargs: its keyword arguments
+    """
+    return call(*args, **kwargs)
+
+
 def check_attach_and_reserve_volume(context, volume_api, volume, instance,
                                     bdm, supports_multiattach=False,
                                     validate_az=True):
