+        # Tests that a start which fails while nova-conductor lost its
+        # database clears the task state powering-on once the database is
+        # back, so the API accepts the next start of the server.
+        instance = fake_instance.fake_instance_obj(
+            self.context, vm_state=vm_states.STOPPED,
