+    @mock.patch('retrying.time.sleep')
+    def test_reverts_task_state_once_for_the_named_methods(self, mock_sleep):
+        # Tests that the methods of _REVERTS_TASK_STATE_ONCE give up the
+        # revert on the first lost database, so the caller of an RPC call
+        # gets its answer without waiting for the database.
+        instance = objects.Instance(uuid=uuids.instance, task_state="FAKE")
+
+        def set_admin_password(self, context, instance):
+            raise test.TestingException()
+
+        def fake_function(self, context, instance):
+            raise test.TestingException()
+
+        for function, attempts in ((set_admin_password, 1),
+                                   (fake_function, 19)):
+            instance_update = mock.Mock(side_effect=self._lost_database())
+            self.compute._instance_update = instance_update
+            self.assertRaises(test.TestingException,
+                              manager.reverts_task_state(function),
+                              self.compute, self.context, instance)
+            self.assertEqual(attempts, instance_update.call_count,
+                             function.__name__)
+
+    def test_reverts_task_state_once_names_methods_of_the_manager(self):
+        # Tests that every name of _REVERTS_TASK_STATE_ONCE is a method of
+        # the compute manager that reverts_task_state wraps, so a rename
+        # does not turn the revert of an RPC call into a retried one.
+        # Not every decorator sets __wrapped__ (messaging.expected_exceptions
+        # does not), so the walk follows the closures, as
+        # safe_utils.get_wrapped_function does.
+        def revert_once_of(function):
+            found = []
+            closure = getattr(function, '__closure__', None) or ()
+            names = function.__code__.co_freevars if closure else ()
+            for name, cell in zip(names, closure):
+                if name == 'revert_once':
+                    found.append(cell.cell_contents)
+                elif inspect.isfunction(cell.cell_contents):
+                    found.extend(revert_once_of(cell.cell_contents))
+            return found
+
+        for name in manager._REVERTS_TASK_STATE_ONCE:
+            method = getattr(manager.ComputeManager, name, None)
+            self.assertTrue(inspect.isfunction(method), name)
+            self.assertEqual([True], revert_once_of(method), name)
+        # The walk finds the flag of a method that retries its revert.
+        self.assertEqual(
+            [False], revert_once_of(manager.ComputeManager.start_instance))
+
