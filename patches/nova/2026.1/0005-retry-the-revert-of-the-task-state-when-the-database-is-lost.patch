index e6de3ea..57a8d56 100644
--- a/nova/compute/manager.py
+++ b/nova/compute/manager.py
@@ -145,9 +145,35 @@ def errors_out_migration(function):
     return decorated_function
 
 
+# NOTE: reverts_task_state waits out a lost database before it gives up the
+# revert of the task state, except for the methods named here, which revert
+# once. Six of them are RPC calls, not casts, so a caller waits for their
+# answer: nova-api for set_admin_password, nova-conductor for
+# reserve_block_device_name and for the four steps of a cross-cell resize. A
+# revert that waited would hold that caller as well, and set_admin_password's
+# caller gives up after rpc_response_timeout. terminate_instance clears its
+# task state in the retried write of its ERROR state, so a second wait would
+# only hold its RPC worker longer.
+_REVERTS_TASK_STATE_ONCE = frozenset([
+    'terminate_instance',
+    'set_admin_password',
+    'reserve_block_device_name',
+    'prep_snapshot_based_resize_at_source',
+    'finish_snapshot_based_resize_at_dest',
+    'revert_snapshot_based_resize_at_dest',
+    'finish_revert_snapshot_based_resize_at_source',
+])
+
+
 @utils.expects_func_args('instance')
 def reverts_task_state(function):
-    """Decorator to revert task_state on failure."""
+    """Decorator to revert task_state on failure.
+
+    A revert that meets a lost database is retried with
+    compute_utils.call_with_db_retries, unless the method is in
+    _REVERTS_TASK_STATE_ONCE.
+    """
+    revert_once = function.__name__ in _REVERTS_TASK_STATE_ONCE
 
     @functools.wraps(function)
     def decorated_function(self, context, *args, **kwargs):
@@ -171,7 +197,13 @@ def reverts_task_state(function):
                 instance = keyed_args['instance']
                 original_task_state = instance.task_state
                 try:
-                    self._instance_update(context, instance, task_state=None)
+                    if revert_once:
+                        self._instance_update(context, instance,
+                                              task_state=None)
+                    else:
+                        compute_utils.call_with_db_retries(
+                            self._instance_update, context, instance,
+                            task_state=None)
                     LOG.info("Successfully reverted task state from %s on "
                              "failure for instance.",
                              original_task_state, instance=instance)
diff --git a/nova/compute/utils.py b/nova/compute/utils.py
index 16db8a9..5c09fd2 100644
--- a/nova/compute/utils.py
+++ b/nova/compute/utils.py
@@ -1686,11 +1686,14 @@ def _is_lost_database(exc):
 
 
 # NOTE: The waits add up to 254 seconds, the bound of call_cinder_with_retries,
-# which outlasts a database failover. The caller is
-# ComputeManager.terminate_instance, whose write of the ERROR state after a
-# failed delete is the one that ends the task state deleting: the API ignores
-# every later delete while the server keeps it. Each wait holds the instance
-# lock and one RPC worker of nova-compute, so the waits stop growing at 16
+# which outlasts a database failover. ComputeManager.terminate_instance writes
+# the ERROR state of a failed delete with it, which ends the task state
+# deleting: the API ignores every later delete while the server keeps it.
+# reverts_task_state writes the revert of the task state of another failed
+# operation with it: while the server keeps that task state, the API answers
+# a start, a stop, a volume detach or an interface attach with a 409. Each
+# wait holds the worker of nova-compute that runs the operation, and in
+# terminate_instance also the instance lock, so the waits stop growing at 16
 # seconds: once the database is back, the next attempt follows within 16
 # seconds.
 @retrying.retry(retry_on_exception=_is_lost_database,
