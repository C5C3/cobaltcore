+@mock.patch('retrying.time.sleep')
+class CallUntilPlacementAnswersTestCase(test.NoDBTestCase):
+    def setUp(self):
+        super().setUp()
+        self.call = mock.Mock(return_value=mock.sentinel.client)
+
+    @staticmethod
+    def _waits(mock_sleep):
+        # The patch replaces time.sleep, which other code calls with 0.
+        return [c.args[0] for c in mock_sleep.call_args_list if c.args[0]]
+
+    def _call(self):
+        return compute_utils.call_until_placement_answers(self.call)
+
+    def test_call_until_placement_answers(self, mock_sleep):
+        self.assertEqual(mock.sentinel.client, self._call())
+        self.call.assert_called_once_with()
+        self.assertEqual([], self._waits(mock_sleep))
+
+    @mock.patch.object(compute_utils.LOG, 'warning')
+    def test_call_until_placement_answers_waits_out_an_outage(
+            self, mock_warning, mock_sleep):
+        unreachable = [
+            keystone_exception.ConnectFailure('refused'),
+            keystone_exception.ConnectTimeout('timed out'),
+            keystone_exception.InternalServerError(),
+            keystone_exception.BadGateway(),
+            keystone_exception.ServiceUnavailable(),
+            keystone_exception.GatewayTimeout(),
+            sdk_exc.NotSupported('no supported versions'),
+        ]
+        self.call.side_effect = unreachable + [mock.sentinel.client]
+        self.assertEqual(mock.sentinel.client, self._call())
+        self.assertEqual(8, self.call.call_count)
+        self.assertEqual([2.0, 4.0, 8.0, 16.0, 16.0, 16.0, 16.0],
+                         self._waits(mock_sleep))
+        self.assertEqual(
+            [mock.call('Keystone or Placement did not answer the creation '
+                       'of the Placement client, retrying: %s', exc)
+             for exc in unreachable],
+            mock_warning.call_args_list)
+
+    def test_call_until_placement_answers_has_no_attempt_limit(
+            self, mock_sleep):
+        self.call.side_effect = (
+            [keystone_exception.ConnectFailure('refused')] * 40 +
+            [mock.sentinel.client])
+        self.assertEqual(mock.sentinel.client, self._call())
+        self.assertEqual(41, self.call.call_count)
+        self.assertEqual([2.0, 4.0, 8.0] + [16.0] * 37,
+                         self._waits(mock_sleep))
+
+    def test_call_until_placement_answers_does_not_retry_a_configuration(
+            self, mock_sleep):
+        for exc in (keystone_exception.Unauthorized(),
+                    keystone_exception.EndpointNotFound(),
+                    keystone_exception.MissingAuthPlugin(),
+                    keystone_exception.SSLError('bad certificate'),
+                    keystone_exception.HttpNotImplemented(),
+                    exception.ConfGroupForServiceTypeNotFound(stype='x')):
+            self.call.reset_mock()
+            self.call.side_effect = exc
+            self.assertRaises(type(exc), self._call)
+            self.call.assert_called_once_with()
+        self.assertEqual([], self._waits(mock_sleep))
