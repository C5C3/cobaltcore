index 475b02a..196dede 100644
--- a/nova/compute/utils.py
+++ b/nova/compute/utils.py
@@ -23,6 +23,8 @@ import socket
 import traceback
 
 from cinderclient import exceptions as cinder_exception
+from keystoneauth1 import exceptions as keystone_exception
+from openstack import exceptions as sdk_exc
 from oslo_log import log
 import oslo_messaging as messaging
 from oslo_serialization import jsonutils
@@ -1712,6 +1714,52 @@ def call_with_db_retries(call, *args, **kwargs):
     return call(*args, **kwargs)
 
 
+def _is_placement_unreachable(exc):
+    """True when Keystone or Placement could not answer for now.
+
+    A refused, reset or timed-out connection and a 500, 502, 503 or 504 from
+    Keystone are such answers. openstacksdk raises NotSupported when the
+    version discovery of Placement got no answer, which is what a Placement
+    that is down looks like. Every other error, a 401 or a missing endpoint
+    among them, is a configuration nova-compute cannot wait out.
+
+    Logs a warning for every such error, so each attempt of
+    call_until_placement_answers shows in the log.
+    """
+    if isinstance(exc, (keystone_exception.RetriableConnectionFailure,
+                        keystone_exception.InternalServerError,
+                        keystone_exception.BadGateway,
+                        keystone_exception.ServiceUnavailable,
+                        keystone_exception.GatewayTimeout,
+                        sdk_exc.NotSupported)):
+        LOG.warning('Keystone or Placement did not answer the creation of '
+                    'the Placement client, retrying: %s', exc)
+        return True
+    return False
+
+
+# NOTE: ComputeManager.__init__ creates its Placement client while
+# nova-compute starts, and the version discovery of that client needs a token
+# from Keystone and an answer from Placement. Like Service.__init__'s wait
+# for nova-conductor, which runs just before, it waits as long as it takes:
+# an error raised here ends the process. The waits stop growing at 16
+# seconds, so the client follows within 16 seconds of the two answering.
+@retrying.retry(retry_on_exception=_is_placement_unreachable,
+                wait_exponential_multiplier=1000,
+                wait_exponential_max=16000)
+def call_until_placement_answers(call, *args, **kwargs):
+    """Call a method that creates a Placement client, waiting out an
+    unreachable Keystone or Placement.
+
+    Every other error goes to the caller on the first attempt.
+
+    :param call: the method to call
+    :param args: its positional arguments
+    :param kwargs: its keyword arguments
+    """
+    return call(*args, **kwargs)
+
+
 def check_attach_and_reserve_volume(context, volume_api, volume, instance,
                                     bdm, supports_multiattach=False,
                                     validate_az=True):
