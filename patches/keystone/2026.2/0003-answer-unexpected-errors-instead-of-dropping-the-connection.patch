 from oslo_serialization import jsonutils
@@ -103,6 +104,15 @@ def middleware_exceptions(method):
                 request=request,
                 user_locale=best_match_language(request),
             )
+        except db_exception.DBConnectionError as e:
+            # The database is unreachable: answer 503, as the token issue
+            # path does, instead of a 500.
+            LOG.exception(e)
+            return render_exception(
+                exception.ServiceUnavailable(),
+                request=request,
+                user_locale=best_match_language(request),
+            )
         except Exception as e:
             LOG.exception(e)
             return render_exception(
diff --git a/keystone/tests/unit/server/test_keystone_flask.py b/keystone/tests/unit/server/test_keystone_flask.py
index 2d4158f27..fa48d5526 100644
--- a/keystone/tests/unit/server/test_keystone_flask.py
+++ b/keystone/tests/unit/server/test_keystone_flask.py
@@ -17,6 +17,7 @@ import uuid
 import fixtures
 import flask
 import flask_restful
+from oslo_db import exception as db_exception
 from oslo_policy import policy
 from oslo_serialization import jsonutils
 from testtools import matchers
@@ -803,3 +804,60 @@ class TestKeystoneFlaskUnrouted404(rest.RestfulTestCase):
             self.assertIn('text/html', resp.headers['Content-Type'])
             # Ensure the more generic flask/werkzeug 404 response is emitted
             self.assertTrue(b'404 Not Found' in resp.data)
+
+
+class TestKeystoneFlaskUnexpectedErrors(rest.RestfulTestCase):
+    """An exception a view raises answers JSON instead of escaping."""
+
+    def _post_token(self, error, expected_status_code):
+        self.useFixture(
+            fixtures.MockPatch(
+                'keystone.api._shared.authentication.authenticate_for_token',
+                side_effect=error,
+            )
+        )
+        auth_json = {
+            'auth': {
+                'identity': {
+                    'methods': ['password'],
+                    'password': {
+                        'user': {
+                            'name': uuid.uuid4().hex,
+                            'password': uuid.uuid4().hex,
+                            'domain': {'id': CONF.identity.default_domain_id},
+                        }
+                    },
+                },
+                'scope': {'project': {'id': uuid.uuid4().hex}},
+            }
+        }
+        return self.test_client().post(
+            '/v3/auth/tokens',
+            json=auth_json,
+            expected_status_code=expected_status_code,
+        )
+
+    def test_lost_database_answers_503(self):
+        resp = self._post_token(
+            db_exception.DBConnectionError(), expected_status_code=503
+        )
+        self.assertEqual(503, resp.json['error']['code'])
+        self.assertEqual('Service Unavailable', resp.json['error']['title'])
+
+    def test_other_database_error_answers_500(self):
+        resp = self._post_token(
+            db_exception.DBDeadlock(), expected_status_code=500
+        )
+        self.assertEqual(500, resp.json['error']['code'])
+        self.assertEqual('Internal Server Error', resp.json['error']['title'])
+
+    def test_unexpected_error_answers_json_500(self):
+        self.config_fixture.config(insecure_debug=False)
+        marker = uuid.uuid4().hex
+        resp = self._post_token(RuntimeError(marker), expected_status_code=500)
+        self.assertEqual(500, resp.json['error']['code'])
+        self.assertNotIn(marker, resp.get_data(as_text=True))
+
+    def test_type_error_still_answers_400(self):
+        resp = self._post_token(TypeError('x'), expected_status_code=400)
+        self.assertEqual(400, resp.json['error']['code'])
