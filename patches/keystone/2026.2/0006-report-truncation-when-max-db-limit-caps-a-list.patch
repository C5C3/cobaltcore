diff --git a/keystone/tests/unit/test_v3.py b/keystone/tests/unit/test_v3.py
index 73c864d..10e6824 100644
--- a/keystone/tests/unit/test_v3.py
+++ b/keystone/tests/unit/test_v3.py
@@ -1785,6 +1785,50 @@ class PaginationTestCaseBase(RestfulTestCase):
             "Next page link contains corrected limit and marker",
         )
 
+    def test_list_no_limit_capped_by_max_db_limit(self):
+        """Tests listing resources cut by max_db_limit only"""
+        # Neither the `limit` query parameter nor `list_limit` is set, so
+        # `max_db_limit` is the only cap applied to the query.
+        self.config_fixture.config(max_db_limit=4)
+
+        count_resources: int = 6
+        self._create_resources(count_resources)
+
+        response = self.get(f'/{self.resource_name}s')
+        res_list = response.json_body[f"{self.resource_name}s"]
+        res_links = response.json_body['links']
+        self.assertEqual(4, len(res_list), "max_db_limit caps the result")
+        self.assertIs(
+            response.json_body.get('truncated'),
+            True,
+            "Result cut by max_db_limit is reported as truncated",
+        )
+        self.assertEqual(
+            f"http://localhost/v3/{self.resource_name}s?marker={res_list[-1]['id']}&limit=4",
+            res_links.get("next"),
+            "Next page link contains the applied limit and marker",
+        )
+
+    def test_list_no_limit_below_max_db_limit(self):
+        """Tests listing resources not reaching any limit"""
+        self.config_fixture.config(max_db_limit=100)
+
+        count_resources: int = 6
+        self._create_resources(count_resources)
+
+        response = self.get(f'/{self.resource_name}s')
+        res_list = response.json_body[f"{self.resource_name}s"]
+        res_links = response.json_body['links']
+        self.assertGreaterEqual(
+            len(res_list), count_resources, "All test resources are returned"
+        )
+        self.assertNotIn(
+            'truncated',
+            response.json_body,
+            "Complete collection is not reported as truncated",
+        )
+        self.assertIsNone(res_links.get("next"), "Next page link is empty")
+
     def _consume_paginated_list(
         self, limit: ty.Optional[int] = None
     ) -> tuple[list[dict], int]:
diff --git a/releasenotes/notes/report-truncation-with-max-db-limit-89d415e6d6be36cd.yaml b/releasenotes/notes/report-truncation-with-max-db-limit-89d415e6d6be36cd.yaml
new file mode 100644
index 0000000..749611d
--- /dev/null
+++ b/releasenotes/notes/report-truncation-with-max-db-limit-89d415e6d6be36cd.yaml
@@ -0,0 +1,11 @@
+---
+fixes:
+  - |
+    [`bug 2163597 <https://bugs.launchpad.net/keystone/+bug/2163597>`_]
+    List responses are now correctly reported as truncated when the result was
+    cut by the ``[DEFAULT] max_db_limit`` option. Previously, when neither the
+    ``limit`` query parameter nor the ``[DEFAULT] list_limit`` option was set,
+    ``GET /v3/users``, ``/v3/groups``, ``/v3/projects`` and ``/v3/domains``
+    silently returned at most ``max_db_limit`` entries without the
+    ``truncated`` flag or a ``links.next`` reference, leaving clients unable to
+    tell a complete collection from a truncated one.
