+    def test_strip_domain_roles_looks_up_each_role_id_once(self):
+        # Each distinct role ID is read once, as the assignment spells it: on
+        # a database with a case-insensitive collation get_role resolves
+        # another spelling of a stored ID the way the database does.
+        global_id = uuid.uuid4().hex
+        domain_role_id = uuid.uuid4().hex
+        roles = {
+            global_id: {'id': global_id, 'domain_id': None},
+            global_id.upper(): {'id': global_id, 'domain_id': None},
+            domain_role_id: {
+                'id': domain_role_id,
+                'domain_id': CONF.identity.default_domain_id,
+            },
+        }
+        refs = [
+            {
+                'user_id': uuid.uuid4().hex,
+                'project_id': uuid.uuid4().hex,
+                'role_id': role_id,
+            }
+            for role_id in (
+                global_id,
+                domain_role_id,
+                global_id,
+                global_id.upper(),
+                domain_role_id,
+            )
+        ]
+        with mock.patch.object(
+            PROVIDERS.role_api, 'get_role', side_effect=roles.__getitem__
+        ) as get_role:
+            self.assertEqual(
+                [refs[0], refs[2], refs[3]],
+                PROVIDERS.assignment_api._strip_domain_roles(refs),
+            )
+        self.assertEqual(
+            [
+                mock.call(global_id),
+                mock.call(domain_role_id),
+                mock.call(global_id.upper()),
+            ],
+            get_role.call_args_list,
+        )
