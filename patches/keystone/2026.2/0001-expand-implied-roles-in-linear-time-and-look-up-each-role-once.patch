+    def test_add_implied_roles_keeps_order_through_a_cycle(self):
+        r0, r1, r2 = (self._create_role()['id'] for _ in range(3))
+        PROVIDERS.role_api.create_implied_role(r0, r1)
+        PROVIDERS.role_api.create_implied_role(r1, r2)
+        PROVIDERS.role_api.create_implied_role(r2, r0)
+        u, p0, p1, g = (uuid.uuid4().hex for _ in range(4))
+
+        refs = PROVIDERS.assignment_api.add_implied_roles(
+            [
+                {'user_id': u, 'project_id': p0, 'role_id': r0},
+                {
+                    'user_id': u,
+                    'project_id': p1,
+                    'role_id': r1,
+                    'indirect': {'group_id': g},
+                },
+            ]
+        )
+
+        # The expansion pops the last ref first and stops at the first ref
+        # it has already expanded, so the order and the duplicates are fixed.
+        self.assertEqual(
+            [
+                {'user_id': u, 'project_id': p0, 'role_id': r0},
+                {
+                    'user_id': u,
+                    'project_id': p1,
+                    'role_id': r1,
+                    'indirect': {'group_id': g},
+                },
+                {
+                    'user_id': u,
+                    'project_id': p1,
+                    'role_id': r2,
+                    'indirect': {'group_id': g, 'role_id': r1},
+                },
+                {
+                    'user_id': u,
+                    'project_id': p1,
+                    'role_id': r0,
+                    'indirect': {'group_id': g, 'role_id': r2},
+                },
+                {
+                    'user_id': u,
+                    'project_id': p1,
+                    'role_id': r1,
+                    'indirect': {'group_id': g, 'role_id': r0},
+                },
+                {
+                    'user_id': u,
+                    'project_id': p0,
+                    'role_id': r1,
+                    'indirect': {'role_id': r0},
+                },
+                {
+                    'user_id': u,
+                    'project_id': p0,
+                    'role_id': r2,
+                    'indirect': {'role_id': r1},
+                },
+                {
+                    'user_id': u,
+                    'project_id': p0,
+                    'role_id': r0,
+                    'indirect': {'role_id': r2},
+                },
+            ],
+            refs,
+        )
