+        def _ref_key(value):
+            # A hashable stand-in for a ref that compares equal exactly when
+            # the dicts do: the nested indirect dict becomes a frozenset of
+            # its items, a list a tuple. Keeping the checked refs in a set of
+            # these keys makes the cycle check constant time per ref instead
+            # of a scan of every ref checked so far.
+            if isinstance(value, dict):
+                return frozenset((k, _ref_key(v)) for k, v in value.items())
+            if isinstance(value, list):
+                return tuple(_ref_key(v) for v in value)
+            return value
