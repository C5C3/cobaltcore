+    def test_effective_listing_looks_up_each_role_once(self):
+        user, projects = self._create_user_and_projects(3)
+        r0 = self._create_role()['id']
+        r1 = self._create_role()['id']
+        d0 = self._create_role(domain_id=CONF.identity.default_domain_id)['id']
+        PROVIDERS.role_api.create_implied_role(r0, r1)
+        PROVIDERS.role_api.create_implied_role(d0, r1)
+        for project in projects:
+            PROVIDERS.assignment_api.create_grant(
+                r0, user_id=user['id'], project_id=project['id']
+            )
+        PROVIDERS.assignment_api.create_grant(
+            d0, user_id=user['id'], project_id=projects[0]['id']
+        )
+
+        with mock.patch.object(
+            PROVIDERS.role_api, 'get_role', wraps=PROVIDERS.role_api.get_role
+        ) as get_role:
+            refs = PROVIDERS.assignment_api.list_role_assignments(
+                user_id=user['id'], effective=True
+            )
+
+        # Three direct r0 grants, three r1 implied by them and one r1
+        # implied by the domain-specific d0, which itself is stripped.
+        self.assertThat(refs, matchers.HasLength(7))
+        self.assertEqual(3, [ref['role_id'] for ref in refs].count(r0))
+        self.assertEqual(4, [ref['role_id'] for ref in refs].count(r1))
+        self.assertNotIn(d0, [ref['role_id'] for ref in refs])
+        # Eight refs before the stripping, three distinct roles among them.
+        self.assertEqual(
+            sorted([r0, r1, d0]),
+            sorted(call.args[0] for call in get_role.call_args_list),
+        )
+
