+    def _key_repository(self, directory_mode, key_modes):
+        directory = self.useFixture(fixtures.TempDir()).path
+        for name, mode in key_modes.items():
+            path = os.path.join(directory, name)
+            with open(path, 'w') as key_file:
+                key_file.write('key-' + name)
+            os.chmod(path, mode)
+        os.chmod(directory, directory_mode)
+        return directory
+
+    def _fernet_utils(self, directory):
+        return fernet_utils.FernetUtils(directory, 3, 'fernet_tokens')
+
+    def test_world_readable_repository_with_private_keys_logs_no_warning(self):
+        directory = self._key_repository(0o755, {'0': 0o400})
+        logger = self.useFixture(fixtures.FakeLogger(level=log.WARNING))
+        keys = self._fernet_utils(directory).load_keys()
+        self.assertEqual(['key-0'], keys)
+        self.assertNotIn('key_repository is world readable', logger.output)
+
+    def test_secret_volume_layout_with_private_keys_logs_no_warning(self):
+        # The kubelet projects a Secret as <key> -> ..data/<key>, with ..data
+        # a link to a 0755 timestamped directory; neither is a regular file.
+        directory = self.useFixture(fixtures.TempDir()).path
+        data_dir = os.path.join(directory, '..2026_11_17_00_00_00.1')
+        os.mkdir(data_dir)
+        key = os.path.join(data_dir, '0')
+        with open(key, 'w') as key_file:
+            key_file.write('key-0')
+        os.chmod(key, 0o400)
+        os.chmod(data_dir, 0o755)
+        os.symlink(
+            os.path.basename(data_dir), os.path.join(directory, '..data')
+        )
+        os.symlink(os.path.join('..data', '0'), os.path.join(directory, '0'))
+        os.chmod(directory, 0o755)
+        logger = self.useFixture(fixtures.FakeLogger(level=log.WARNING))
+        keys = self._fernet_utils(directory).load_keys()
+        self.assertEqual(['key-0'], keys)
+        self.assertNotIn('key_repository is world readable', logger.output)
