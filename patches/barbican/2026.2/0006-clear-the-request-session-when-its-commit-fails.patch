+from unittest import mock
+
+from oslo_db import exception as db_exc
+from oslotest import base as oslotest_base
+import sqlalchemy
+from sqlalchemy import event
+
+from barbican.api import hooks
+from barbican.model import models
+from barbican.model import repositories
+from barbican.tests import database_utils
+from barbican.tests import utils
+
+
+def _state(transactional=True, error=False):
+    """Return the pecan state of a request that reached no controller."""
+    state = mock.Mock(spec=['request', 'controller'])
+    state.controller = None
+    state.request = mock.Mock(spec=['transactional', 'error'])
+    state.request.transactional = transactional
+    state.request.error = error
+    return state
+
+
+class WhenTheTransactionHookRunsAfterARequest(oslotest_base.BaseTestCase):
+
+    def setUp(self):
+        super(WhenTheTransactionHookRunsAfterARequest, self).setUp()
+        database_utils.setup_in_memory_db()
+        self.addCleanup(database_utils.in_memory_cleanup)
+
+    def _assert_session_cleared(self, old_session):
+        session = repositories.get_session()
+        self.assertIsNot(old_session, session)
+        self.assertEqual(1, session.execute(
+            sqlalchemy.text('SELECT 1')).scalar())
+
+    def test_a_failed_commit_clears_the_session(self):
+        old_session = repositories.get_session()
+        # The hook holds the functions it was built with.
+        with mock.patch.object(repositories, 'commit',
+                               side_effect=db_exc.DBConnectionError()):
+            hook = hooks.BarbicanTransactionHook()
+
+        self.assertRaises(db_exc.DBConnectionError, hook.after, _state())
+        self._assert_session_cleared(old_session)
+
+    def test_a_failed_rollback_clears_the_session(self):
+        old_session = repositories.get_session()
+        with mock.patch.object(repositories, 'rollback',
+                               side_effect=db_exc.DBConnectionError()):
+            hook = hooks.BarbicanTransactionHook()
+
+        self.assertRaises(db_exc.DBConnectionError, hook.after,
+                          _state(error=True))
+        self._assert_session_cleared(old_session)
+
+    def test_a_read_only_request_neither_commits_nor_rolls_back(self):
+        old_session = repositories.get_session()
+        with mock.patch.object(repositories, 'commit') as mock_commit, \
+                mock.patch.object(repositories, 'rollback') as mock_rollback:
+            hook = hooks.BarbicanTransactionHook()
+
+        hook.after(_state(transactional=False))
+
+        mock_commit.assert_not_called()
+        mock_rollback.assert_not_called()
+        self._assert_session_cleared(old_session)
+
+    def test_a_successful_request_commits_once(self):
+        project = models.Project()
+        project.external_id = 'hook project'
+        repositories.get_session().add(project)
+        with mock.patch.object(repositories, 'commit',
+                               wraps=repositories.commit) as mock_commit:
+            hook = hooks.BarbicanTransactionHook()
+
+        hook.after(_state())
+
+        mock_commit.assert_called_once_with()
+        self.assertEqual(1, repositories.get_session().query(
+            models.Project).filter_by(external_id='hook project').count())
+
+
+class WhenACommitFailsDuringARequest(utils.BarbicanAPIBaseTestCase):
+
+    def test_the_next_request_gets_a_new_session(self):
+        engine = repositories.get_session().get_bind()
+        calls = {'n': 0}
+
+        def _commit(conn):
+            calls['n'] += 1
+            if calls['n'] == 1:
+                # The server lost the transaction with the connection.
+                # Without the rollback the test's single sqlite connection
+                # stays inside the transaction.
+                conn.connection.dbapi_connection.rollback()
+                raise db_exc.DBConnectionError()
+
+        event.listen(engine, 'commit', _commit)
+        self.addCleanup(event.remove, engine, 'commit', _commit)
+
+        self.assertRaises(db_exc.DBConnectionError, self.app.post_json,
+                          '/secrets/', {'name': 'lost commit'})
+        resp = self.app.get('/secrets/', expect_errors=True)
+
+        self.assertEqual(200, resp.status_int)
