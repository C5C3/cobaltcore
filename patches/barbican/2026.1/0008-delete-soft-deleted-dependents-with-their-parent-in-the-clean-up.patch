+def _delete_soft_deleted_dependents(session, label, dependent_key,
+                                    parent_ids):
+    """Delete the soft-deleted rows that still reference the given parents.
+
+    A soft delete stamps the parent first and each child afterwards with a
+    time of its own, and the columns hold whole seconds, so a child can
+    carry a later deleted_at than its parent. When the cutoff of a run
+    falls between the two, the pass over the child table leaves the row and
+    the delete of the parent fails on the foreign key. The rows are read
+    first, so the usual batch, which finds none, locks nothing in the child
+    table, and they are deleted by id, at most _IDS_PER_STATEMENT per
+    statement. A row that was never soft-deleted is left alone, and the
+    delete of its parent fails on it.
+
+    :param session: the session of the batch.
+    :param label: name of the parent rows in log lines.
+    :param dependent_key: the foreign key column of the dependent model
+                          that references the parent, for example
+                          models.SecretStoreMetadatum.secret_id.
+    :param parent_ids: ids of the parents this batch deletes.
+    :returns: the rows deleted.
+    """
+    model = dependent_key.class_
+    ids = [row[0] for row in
+           session.query(model.id).filter(
+               dependent_key.in_(parent_ids)).filter(model.deleted).all()]
+    count = 0
+    for start in range(0, len(ids), _IDS_PER_STATEMENT):
+        count += session.query(model).filter(
+            model.id.in_(ids[start:start + _IDS_PER_STATEMENT])
+        ).delete(synchronize_session=False)
+    if count:
+        LOG.info("Clean-up batch for %(label)s deletes %(count)s "
+                 "soft-deleted %(model_name)s entries ahead of their own "
+                 "cutoff, with the parents they reference",
+                 {'label': label, 'count': count,
+                  'model_name': model.__name__})
+    return count
+
