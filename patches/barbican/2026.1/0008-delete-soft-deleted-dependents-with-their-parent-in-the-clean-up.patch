+    def test_clean_command_counts_the_batches_of_a_failed_pass(self):
+        """A failed run reports the rows its batches committed."""
+        project = utils.create_project(external_id='p-count')
+        secret = _setup_entry('secret', project=project)
+        _setup_entry('secret_user_metadatum', secret=secret)
+        key_ids = _committed_soft_deleted_transport_keys(3)
+        _soft_delete_at(secret, timeutils.utcnow())
+        repos.commit()
+
+        with mock.patch.object(clean.LOG, 'exception') as mock_exc, \
+                mock.patch.object(clean.LOG, 'info') as mock_info:
+            self._clean_command(raises=db_exc.DBReferenceError, batch_size=2)
+
+        self.assertEqual(0, _transport_keys_left(key_ids))
+        self.assertEqual(('Failed to clean up soft deletions in database. '
+                          '%s entries were committed before the failure.',
+                          3), mock_exc.call_args.args)
+        self.assertIn(mock.call('Cleaning of database affected %s entries',
+                                3), mock_info.call_args_list)
+        self.assertEqual(3, clean._rows_committed)
+
+        # The next run starts its count at zero.
+        repos.rollback()
+        session = repos.get_session()
+        session.query(models.SecretUserMetadatum).delete()
+        repos.commit()
+        with mock.patch.object(clean.LOG, 'info') as mock_info:
+            self._clean_command()
+        self.assertIn(mock.call('Cleaning of database affected %s entries',
+                                1), mock_info.call_args_list)
+        self.assertEqual(1, clean._rows_committed)
