@@ -34,6 +36,102 @@ DEFAULT_CLEANUP_BATCH_SIZE = 10000
 # cleanup runs without attaching a debugger or querying the database.
 _PROGRESS_LOG_EVERY_N_BATCHES = 10
 
+# Retries of one batch that conflicts with a concurrent write. wrap_db_retry
+# waits 1 s before the first retry, then a random time below a bound that
+# doubles from 2 s and is capped at 10 s, so ten retries wait 75 s at most.
+CLEANUP_BATCH_MAX_RETRIES = 10
+
+# Most ids one DELETE or UPDATE of a batch names. MariaDB 12.3 runs a
+# statement naming 10,000 ids of a 50,000-row table as a full table scan,
+# and under REPEATABLE READ that locking scan fails with error 1020 on any
+# row written after the batch read its ids, on every retry alike. Naming at
+# most 500 ids keeps the statement on the primary key, so it reads only the
+# rows of the batch, for tables of a few thousand rows and more.
+_IDS_PER_STATEMENT = 500
+
+
+@oslo_db_api.wrap_db_retry(max_retries=CLEANUP_BATCH_MAX_RETRIES,
+                           retry_interval=1,
+                           inc_retry_interval=True,
+                           max_retry_interval=10,
+                           retry_on_deadlock=True)
+def _run_batch(label, id_query_fn, apply_fn, batch_size):
+    """Change one batch of rows and commit it.
+
+    Reads up to ``batch_size`` ids through ``id_query_fn``, changes those
+    rows through ``apply_fn``, at most _IDS_PER_STATEMENT ids per call,
+    and commits, so each batch is a short transaction of its own.
+
+    A batch that conflicts with a concurrent write raises ``DBDeadlock``:
+    oslo.db maps MySQL errors 1213 and 1205 to it, and MariaDB's 1020
+    ("Record has changed since last read") to its subclass
+    ``DBConsistencyError``. The batch is rolled back, which ends its
+    transaction and its snapshot, logged, and run again by wrap_db_retry
+    up to CLEANUP_BATCH_MAX_RETRIES times. Any other exception passes
+    through on its first occurrence.
+
+    No commit is issued when the id query finds nothing, and no rollback
+    precedes the first attempt: callers may hold uncommitted rows in the
+    session.
+
+    :param label: name of the rows in log lines.
+    :param id_query_fn: callable taking the session and returning the
+                        query of the ids to change.
+    :param apply_fn: callable taking the session and a list of ids,
+                     changing those rows and returning how many it
+                     changed.
+    :param batch_size: max rows changed per committed batch.
+    :returns: the rows changed, or None when id_query_fn finds no id.
+    """
+    session = repo.get_session()
+    try:
+        ids = [row[0] for row in
+               id_query_fn(session).limit(batch_size).all()]
+        if not ids:
+            return None
+        count = 0
+        for start in range(0, len(ids), _IDS_PER_STATEMENT):
+            count += apply_fn(session,
+                              ids[start:start + _IDS_PER_STATEMENT])
+        # Detach all ORM objects before commit so that expire_on_commit
+        # does not clear their __dict__. Test code and callers holding
+        # object references can still read pk attributes from the
+        # detached state.
+        session.expunge_all()
+        repo.commit()
+        return count
+    except db_exc.DBDeadlock as exc:
+        repo.rollback()
+        LOG.warning("Clean-up batch for %(label)s conflicted with a "
+                    "concurrent write and is retried: %(error)s",
+                    {'label': label, 'error': exc})
+        raise
+
+
+def _run_batches(label, id_query_fn, apply_fn, batch_size):
+    """Change rows in committed batches until the id query finds none.
+
+    Each batch is run by _run_batch, so a failure keeps the batches
+    committed before it.
+
+    :param label: name of the rows in log lines.
+    :param id_query_fn: see _run_batch.
+    :param apply_fn: see _run_batch.
+    :param batch_size: max rows changed per committed batch.
+    :returns: the rows changed over all batches.
+    """
+    total = 0
+    batch_no = 0
+    while True:
+        count = _run_batch(label, id_query_fn, apply_fn, batch_size)
+        if count is None:
+            return total
+        total += count
+        batch_no += 1
+        if batch_no % _PROGRESS_LOG_EVERY_N_BATCHES == 0:
+            LOG.debug("[%s] progress: %d batches committed, %d rows so far",
+                      label, batch_no, total)
+
 
