+    def test_run_batch_names_a_bounded_number_of_ids_per_statement(self):
+        """A batch is changed in several statements and committed once."""
+        ids = _committed_soft_deleted_transport_keys(5)
+        statements = []
+
+        def _delete(session, chunk):
+            statements.append(list(chunk))
+            return session.query(models.TransportKey).filter(
+                models.TransportKey.id.in_(chunk)).delete(
+                    synchronize_session=False)
+
+        def _id_query(session):
+            return session.query(models.TransportKey.id).filter_by(
+                deleted=True)
+
+        with mock.patch.object(clean, '_IDS_PER_STATEMENT', 2), \
+                mock.patch('barbican.model.clean.repo.commit',
+                           wraps=repos.commit) as mock_commit:
+            count = clean._run_batch('TransportKey', _id_query, _delete, 10)
+
+        self.assertEqual(5, count)
+        self.assertEqual([2, 2, 1], [len(s) for s in statements])
+        self.assertEqual(sorted(ids), sorted(sum(statements, [])))
+        self.assertEqual(1, mock_commit.call_count)
+        self.assertEqual(0, _transport_keys_left(ids))
