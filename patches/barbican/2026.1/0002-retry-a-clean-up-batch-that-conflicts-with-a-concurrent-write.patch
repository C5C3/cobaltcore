+def _committed_soft_deleted_transport_keys(count):
+    """Create soft-deleted transport keys, commit them, return their ids.
+
+    A retried batch rolls the session back, so the retry tests commit
+    their fixtures before the clean-up runs.
+    """
+    keys = [_setup_entry('transport_key') for _ in range(count)]
+    for k in keys:
+        k.delete()
+    ids = [k.id for k in keys]
+    repos.commit()
+    return ids
+
+
+def _transport_keys_left(ids):
+    session = repos.get_session()
+    return session.query(models.TransportKey).filter(
+        models.TransportKey.id.in_(ids)).count()
+
+
+def _commit_failing_on(error, calls):
+    """Return a commit that raises error on the given call numbers.
+
+    The real commit is bound here, before the test patches repo.commit,
+    so the other calls commit for real.
+    """
+    real_commit = repos.commit
+    state = {'n': 0}
+
+    def commit():
+        state['n'] += 1
+        if state['n'] in calls:
+            raise error
+        real_commit()
+    return commit
+
