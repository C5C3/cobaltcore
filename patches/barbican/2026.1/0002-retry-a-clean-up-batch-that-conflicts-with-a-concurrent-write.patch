+
+        with mock.patch.object(clean, '_IDS_PER_STATEMENT', 2), \
+                mock.patch('barbican.model.clean.repo.commit',
+                           wraps=repos.commit) as mock_commit:
+            total = clean._run_batches('TransportKey', _id_query, _delete,
+                                       10)
+
+        # Without the rollback the retry finds 3 ids, and with a count kept
+        # across attempts it reports 7.
+        self.assertEqual(5, total)
+        self.assertEqual(1, mock_commit.call_count)
