+class WhenTestingSecretMetadataWriteConflicts(utils.BarbicanAPIBaseTestCase):
+    """A metadata write that loses once against a concurrent write.
+
+    The retry rolls back the whole session of the request and runs only
+    the repository method again, so the request must not write anything
+    before it calls that method.
+    """
+
+    def setUp(self):
+        super(WhenTestingSecretMetadataWriteConflicts, self).setUp()
+        self.secret_id, _ = create_secret(self.app)
+        create_secret_metadata(self.app, {'metadata': {'dog': 'poodle'}},
+                               self.secret_id)
+
+    def _stored_metadata(self):
+        resp = self.app.get('/secrets/{}/metadata'.format(self.secret_id))
+        return resp.json['metadata']
+
+    @contextlib.contextmanager
+    def _lose_once(self, method, statement='insert'):
+        """Fail the first INSERT or DELETE of ``method`` after it ran.
+
+        Yields the writes the request made before it called ``method``,
+        which the rollback of the retry discards: the INSERT, UPDATE and
+        DELETE statements it ran and the changes pending in its session.
+        Also yields a list with one entry for the failed attempt.
+        """
+        repo_class = repositories.SecretUserMetadatumRepo
+        real_method = getattr(repo_class, method)
+        real_save = models.SecretUserMetadatum.save
+        real_delete = sa_orm.Query.delete
+        statements = []
+        written = []
+        lost = []
+
+        def record(conn, cursor, sql, parameters, context, executemany):
+            statements.append(sql)
+
+        def enter(repo, *args, **kwargs):
+            session = repositories.get_session()
+            written.extend(sql for sql in statements
+                           if sql.split(None, 1)[0].upper()
+                           in ('INSERT', 'UPDATE', 'DELETE'))
+            written.extend(session.new)
+            written.extend(session.dirty)
+            written.extend(session.deleted)
+            return real_method(repo, *args, **kwargs)
+
+        def lose_once(kind):
+            if kind == statement and not lost:
+                lost.append(kind)
+                raise db_exc.DBDeadlock()
+
+        def save(model, session=None):
+            real_save(model, session=session)
+            lose_once('insert')
+
+        def delete(query, *args, **kwargs):
+            count = real_delete(query, *args, **kwargs)
+            lose_once('delete')
+            return count
+
+        sa_event.listen(sa_engine.Engine, 'before_cursor_execute', record)
+        self.addCleanup(sa_event.remove, sa_engine.Engine,
+                        'before_cursor_execute', record)
+        with mock.patch.object(repo_class, method, autospec=True,
+                               side_effect=enter), \
+                mock.patch.object(models.SecretUserMetadatum, 'save',
+                                  autospec=True, side_effect=save), \
+                mock.patch.object(sa_orm.Query, 'delete', autospec=True,
+                                  side_effect=delete), \
+                mock.patch('time.sleep'):
+            yield written, lost
+
+    def test_replace_metadata_after_a_lost_write(self):
+        with self._lose_once('create_replace_user_metadata') as (
+                written, lost):
+            resp = create_secret_metadata(
+                self.app, {'metadata': {'cat': 'siamese'}}, self.secret_id)
+
+        self.assertEqual(201, resp.status_int)
+        self.assertTrue(resp.json['metadata_ref'].endswith(
+            '/secrets/{}/metadata'.format(self.secret_id)))
+        self.assertEqual({'cat': 'siamese'}, self._stored_metadata())
+        self.assertEqual([], written)
+        self.assertEqual(['insert'], lost)
+
+    def test_create_metadatum_after_a_lost_write(self):
+        with self._lose_once('create_replace_user_metadatum') as (
+                written, lost):
+            resp = create_secret_metadatum(
+                self.app, {'key': 'cat', 'value': 'siamese'}, self.secret_id)
+
+        self.assertEqual(201, resp.status_int)
+        self.assertTrue(resp.headers['Location'].endswith(
+            '/secrets/{}/metadata/cat'.format(self.secret_id)))
+        self.assertEqual({'dog': 'poodle', 'cat': 'siamese'},
+                         self._stored_metadata())
+        self.assertEqual([], written)
+        self.assertEqual(['insert'], lost)
+
+    def test_update_metadatum_after_a_lost_write(self):
+        with self._lose_once('create_replace_user_metadatum') as (
+                written, lost):
+            resp = create_secret_metadatum(
+                self.app, {'key': 'dog', 'value': 'rat terrier'},
+                self.secret_id, remainder='dog', update=True)
+
+        self.assertEqual(200, resp.status_int)
+        self.assertEqual({'key': 'dog', 'value': 'rat terrier'}, resp.json)
+        self.assertEqual({'dog': 'rat terrier'}, self._stored_metadata())
+        self.assertEqual([], written)
+        self.assertEqual(['insert'], lost)
+
+    def test_delete_metadatum_after_a_lost_write(self):
+        with self._lose_once('delete_metadatum', statement='delete') as (
+                written, lost):
+            resp = self.app.delete(
+                '/secrets/{}/metadata/dog'.format(self.secret_id))
+
+        self.assertEqual(204, resp.status_int)
+        self.assertEqual({}, self._stored_metadata())
+        self.assertEqual([], written)
+        self.assertEqual(['delete'], lost)
+
+
