+# Retries of one repository write that lost against a concurrent write.
+# wrap_db_retry waits 0.05 s before the first retry, then a random time
+# below a bound that doubles from 0.1 s and is capped at 1 s, so ten
+# retries wait at most 0.05 + 0.1 + 0.2 + 0.4 + 0.8 + 5 x 1 = 6.55 s.
+WRITE_CONFLICT_MAX_RETRIES = 10
+
+
+def retry_on_write_conflict(fn):
+    """Run a repository write again when it loses to a concurrent write.
+
+    oslo.db raises ``DBDeadlock`` for MySQL errors 1213 and 1205 and its
+    subclass ``DBConsistencyError`` for MariaDB error 1020. InnoDB has
+    rolled back the whole transaction of the request by then, so the
+    session is rolled back, which ends the transaction and its snapshot,
+    and the write runs again in a new one. Every other exception leaves
+    on its first occurrence.
+
+    Decorate only a method whose callers have written nothing earlier in
+    the request: the rollback discards every uncommitted change of the
+    session, and only the decorated method runs again.
+    """
+    @oslo_db_api.wrap_db_retry(retry_interval=0.05,
+                               max_retries=WRITE_CONFLICT_MAX_RETRIES,
+                               inc_retry_interval=True,
+                               max_retry_interval=1,
+                               retry_on_deadlock=True)
+    @functools.wraps(fn)
+    def wrapper(*args, **kwargs):
+        try:
+            return fn(*args, **kwargs)
+        except db_exc.DBDeadlock as exc:
+            rollback()
+            LOG.warning('%s lost against a concurrent write (%s) and is '
+                        'run again', fn.__qualname__, type(exc).__name__)
+            raise
+
+    return wrapper
+
+
