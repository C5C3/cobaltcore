+import base64
+import binascii
+import json
+import threading
+from unittest import mock
+
+from castellan.common import exception
+from castellan.common.objects import opaque_data
+import requests
+
+import barbican.plugin.castellan_secret_store as css
+import barbican.plugin.interface.secret_store as ss
+import barbican.plugin.vault_secret_store as vss
+from barbican.tests import utils
+
+# The shape OpenBao 2.7 sends: base64 of {"cluster": ..., "value": ...}.
+SECRET_INDEX = base64.b64encode(json.dumps(
+    {'cluster': 'c0ffee', 'value': '41'}).encode()).decode()
+LOGIN_INDEX = base64.b64encode(json.dumps(
+    {'cluster': 'c0ffee', 'value': '42'}).encode()).decode()
+
+PAYLOAD = b'stored right before it is read'
+
+
+class WhenTrackingTheVaultStorageIndex(utils.BaseTestCase):
+    """The storage index of a write travels to the reads of that secret.
+
+    The tests replace the transport below the castellan key manager, so
+    every request castellan sends reaches _send, which records it and
+    answers with the next reply the test scripted. A scripted reply that
+    is a function is called first, and its result is the reply.
+    """
+
+    def setUp(self):
+        super().setUp()
+        self.sent = []
+        self.replies = []
+        patcher = mock.patch.object(
+            requests.adapters.HTTPAdapter, 'send', autospec=True,
+            side_effect=self._send)
+        self.transport = patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def _send(self, adapter, request, **kwargs):
+        self.sent.append(request)
+        reply = self.replies.pop(0)
+        if callable(reply):
+            reply = reply()
+        if isinstance(reply, Exception):
+            raise reply
+        status, index, body = reply
+        response = requests.Response()
+        response.status_code = status
+        response.request = request
+        response.url = request.url
+        if index is not None:
+            response.headers[vss.INDEX_HEADER] = index
+        response._content = json.dumps(body).encode('utf-8')
+        return response
+
+    def _store(self, **auth):
+        conf = mock.MagicMock(name='config mock')
+        conf.vault_plugin = mock.MagicMock(
+            vault_url='http://127.0.0.1:8200',
+            use_ssl=False,
+            kv_mountpoint='secret',
+            kv_path=None,
+            kv_version=2,
+            namespace=None,
+            ssl_ca_crt_file=None,
+            root_token_id='root',
+            approle_role_id=None,
+            approle_secret_id=None)
+        conf.vault_plugin.configure_mock(**auth)
+        return vss.VaultSecretStore(conf)
+
+    def _approle_store(self):
+        return self._store(root_token_id=None, approle_role_id='role',
+                           approle_secret_id='secret')
+
+    @staticmethod
+    def _write(index=None):
+        return (200, index, {'data': {'version': 1}})
+
+    @staticmethod
+    def _login(status=200, index=None):
+        return (status, index,
+                {'auth': {'client_token': 'token', 'lease_duration': 3600}})
+
+    @staticmethod
+    def _read(store):
+        record = {
+            'type': store.key_manager._secret_type_dict[
+                opaque_data.OpaqueData],
+            'value': binascii.hexlify(PAYLOAD).decode('utf-8'),
+            'algorithm': None,
+            'bit_length': None,
+            'name': None,
+            'created': None,
+        }
+        return (200, None, {'data': {'data': record}})
+
+    @staticmethod
+    def _secret_dto():
+        return ss.SecretDTO(ss.SecretType.OPAQUE,
+                            base64.b64encode(PAYLOAD),
+                            ss.KeySpec(), None)
+
+    def _metadata(self, index=None):
+        meta = {css.CastellanSecretStore.KEY_ID: 'key-1',
+                css.CastellanSecretStore.METADATA_VERSION: 1}
+        if index is not None:
+            meta[vss.VaultSecretStore.VAULT_INDEX] = index
+        return meta
+
+    def assertCarriesIndex(self, index, request):
+        self.assertEqual(index, request.headers.get(vss.INDEX_HEADER))
+        self.assertEqual(vss.FORWARD_ACTIVE_NODE,
+                         request.headers.get(vss.INCONSISTENT_HEADER))
+
+    def assertCarriesNoIndex(self, request):
+        self.assertNotIn(vss.INDEX_HEADER, request.headers)
+        self.assertNotIn(vss.INCONSISTENT_HEADER, request.headers)
+
+    def test_adapter_is_mounted_for_both_schemes(self):
+        store = self._store()
+        session = store.key_manager._session
+        adapter = session.get_adapter('https://bao.example:8200/')
+        self.assertIsInstance(adapter, vss._StorageIndexAdapter)
+        self.assertIs(adapter, session.get_adapter('http://127.0.0.1:8200/'))
+
+    def test_store_secret_records_the_index_of_the_write(self):
+        store = self._store()
+        self.replies = [self._write(SECRET_INDEX)]
+
+        meta = store.store_secret(self._secret_dto())
+
+        self.assertEqual(SECRET_INDEX, meta[store.VAULT_INDEX])
+        self.assertIn(store.KEY_ID, meta)
+        self.assertEqual('POST', self.sent[0].method)
+
+    def test_generate_symmetric_key_records_the_index_of_the_write(self):
+        store = self._store()
+        self.replies = [self._write(SECRET_INDEX)]
+
+        meta = store.generate_symmetric_key(
+            ss.KeySpec(ss.KeyAlgorithm.AES, 256))
+
+        self.assertEqual(SECRET_INDEX, meta[store.VAULT_INDEX])
+
+    def test_generate_asymmetric_key_records_the_second_index_twice(self):
+        store = self._store()
+        self.replies = [self._write('first-write'),
+                        self._write('second-write')]
+
+        dto = store.generate_asymmetric_key(
+            ss.KeySpec(ss.KeyAlgorithm.RSA, 2048))
+
+        self.assertEqual(2, len(self.sent))
+        self.assertEqual('second-write',
+                         dto.private_key_meta[store.VAULT_INDEX])
+        self.assertEqual('second-write',
+                         dto.public_key_meta[store.VAULT_INDEX])
+
+    def test_write_without_index_records_none(self):
+        store = self._store()
+        self.replies = [self._write()]
+
+        meta = store.store_secret(self._secret_dto())
+
+        self.assertNotIn(store.VAULT_INDEX, meta)
+        self.assertIn(store.KEY_ID, meta)
+
+    def test_write_with_empty_index_records_none(self):
+        store = self._store()
+        self.replies = [self._write('')]
+
+        meta = store.store_secret(self._secret_dto())
+
+        self.assertNotIn(store.VAULT_INDEX, meta)
+
+    def test_write_without_index_after_one_with_records_none(self):
+        store = self._store()
+        self.replies = [self._write(SECRET_INDEX), self._write()]
+
+        store.store_secret(self._secret_dto())
+        meta = store.store_secret(self._secret_dto())
+
+        self.assertNotIn(store.VAULT_INDEX, meta)
+
+    def test_index_of_the_column_width_is_recorded(self):
+        store = self._store()
+        index = 'x' * vss.MAX_INDEX_LENGTH
+        self.replies = [self._write(index)]
+
+        meta = store.store_secret(self._secret_dto())
+
+        self.assertEqual(index, meta[store.VAULT_INDEX])
+
+    def _assert_index_is_not_recorded(self, index):
+        store = self._store()
+        self.replies = [self._write(index)]
+
+        with mock.patch.object(vss.LOG, 'warning') as warning:
+            meta = store.store_secret(self._secret_dto())
+
+        self.assertNotIn(store.VAULT_INDEX, meta)
+        self.assertIn(store.KEY_ID, meta)
+        self.assertEqual(1, warning.call_count)
+        self.assertIn(meta[store.KEY_ID], warning.call_args[0])
+
+    def test_index_longer_than_the_column_is_not_recorded(self):
+        self._assert_index_is_not_recorded('x' * (vss.MAX_INDEX_LENGTH + 1))
+
+    def test_index_with_a_space_is_not_recorded(self):
+        self._assert_index_is_not_recorded('abc def')
+
+    def test_index_with_a_newline_is_not_recorded(self):
+        self._assert_index_is_not_recorded('abc\ndef')
+
+    def test_index_with_a_trailing_newline_is_not_recorded(self):
+        self._assert_index_is_not_recorded('abcdef\n')
+
+    def test_get_secret_sends_the_index_of_the_secret(self):
+        store = self._store()
+        self.replies = [self._read(store)]
+
+        dto = store.get_secret(ss.SecretType.OPAQUE,
+                               self._metadata(SECRET_INDEX))
+
+        self.assertEqual(PAYLOAD, base64.b64decode(dto.secret))
+        self.assertEqual('GET', self.sent[0].method)
+        self.assertCarriesIndex(SECRET_INDEX, self.sent[0])
+
+    def test_get_secret_without_index_sends_none(self):
+        store = self._store()
+        self.replies = [self._read(store)]
+
+        store.get_secret(ss.SecretType.OPAQUE, self._metadata())
+
+        self.assertCarriesNoIndex(self.sent[0])
+
+    def test_request_after_a_login_carries_the_login_index(self):
+        store = self._approle_store()
+        self.replies = [self._login(index=LOGIN_INDEX), self._read(store),
+                        self._read(store)]
+
+        store.get_secret(ss.SecretType.OPAQUE, self._metadata(SECRET_INDEX))
+        store.get_secret(ss.SecretType.OPAQUE, self._metadata(SECRET_INDEX))
+
+        login, first_read, second_read = self.sent
+        self.assertEqual('POST', login.method)
+        self.assertTrue(login.url.endswith('/v1/auth/approle/login'))
+        self.assertCarriesIndex(LOGIN_INDEX, first_read)
+        self.assertCarriesIndex(SECRET_INDEX, second_read)
+
+    def test_write_after_a_login_records_the_index_of_the_write(self):
+        store = self._approle_store()
+        self.replies = [self._login(index=LOGIN_INDEX),
+                        self._write(SECRET_INDEX)]
+
+        meta = store.store_secret(self._secret_dto())
+
+        login, write = self.sent
+        self.assertTrue(login.url.endswith('/v1/auth/approle/login'))
+        self.assertCarriesIndex(LOGIN_INDEX, write)
+        self.assertEqual(SECRET_INDEX, meta[store.VAULT_INDEX])
+
+    def test_refused_login_leaves_the_secret_index(self):
+        store = self._approle_store()
+        self.replies = [self._login(status=403, index=LOGIN_INDEX),
+                        self._login(), self._read(store)]
+
+        self.assertRaises(ss.SecretGeneralException, store.get_secret,
+                          ss.SecretType.OPAQUE, self._metadata(SECRET_INDEX))
+        store.get_secret(ss.SecretType.OPAQUE, self._metadata(SECRET_INDEX))
+
+        refused_login, login, read = self.sent
+        self.assertTrue(refused_login.url.endswith('/login'))
+        self.assertTrue(login.url.endswith('/login'))
+        self.assertCarriesIndex(SECRET_INDEX, read)
+
+    def test_read_of_a_missing_secret_leaves_no_index_behind(self):
+        store = self._store()
+        self.replies = [(404, None, {'errors': []}), self._write()]
+
+        error = self.assertRaises(
+            ss.SecretGeneralException, store.get_secret,
+            ss.SecretType.OPAQUE, self._metadata(SECRET_INDEX))
+        store.store_secret(self._secret_dto())
+
+        self.assertIsInstance(error.reason,
+                              exception.ManagedObjectNotFoundError)
+        self.assertCarriesIndex(SECRET_INDEX, self.sent[0])
+        self.assertCarriesNoIndex(self.sent[1])
+
+    def test_read_that_cannot_connect_leaves_no_index_behind(self):
+        store = self._store()
+        self.replies = [requests.exceptions.ConnectionError('refused'),
+                        self._write()]
+
+        error = self.assertRaises(
+            ss.SecretGeneralException, store.get_secret,
+            ss.SecretType.OPAQUE, self._metadata(SECRET_INDEX))
+        store.store_secret(self._secret_dto())
+
+        self.assertIsInstance(error.reason, exception.KeyManagerError)
+        self.assertCarriesIndex(SECRET_INDEX, self.sent[0])
+        self.assertCarriesNoIndex(self.sent[1])
+
+    def test_read_on_another_thread_lends_no_index_to_a_write(self):
+        # Barbican builds one store per API process, so the request threads
+        # of a worker share it. The write runs while the read on the other
+        # thread is still waiting for its reply.
+        store = self._store()
+        reading = threading.Event()
+        written = threading.Event()
+
+        def read_after_the_write():
+            reading.set()
+            written.wait(10)
+            return self._read(store)
+
+        self.replies = [read_after_the_write, self._write()]
+        reader = threading.Thread(
+            target=store.get_secret,
