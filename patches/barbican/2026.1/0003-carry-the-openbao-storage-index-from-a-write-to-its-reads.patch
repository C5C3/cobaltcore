+# OpenBao 2.7 and newer answer a request that changed storage with the
+# storage index of that change. A standby node that receives the index
+# together with X-Vault-Inconsistent: forward-active-node handles the request
+# itself once it has applied the index, and forwards it to the active node
+# before. A request without an index is handled by whichever node receives it.
+INDEX_HEADER = 'X-Vault-Index'
+INCONSISTENT_HEADER = 'X-Vault-Inconsistent'
+FORWARD_ACTIVE_NODE = 'forward-active-node'
+# The value column of secret_store_metadata is String(255).
+MAX_INDEX_LENGTH = 255
+# Printable ASCII without whitespace: requests refuses to send a header value
+# with a control character, so such an index would fail every later read.
+_INDEX_CHARS = re.compile(r'[\x21-\x7e]+')
+
+
 def list_opts():
     yield vault_opt_group, vault_opts    # pragma: no cover
 
 
+class _StorageIndexState(threading.local):
+    """The storage indexes of the calling thread.
+
+    written is the index of the last write, required is the index the
+    requests of a secret read must reach, and login is the index of an
+    AppRole login that the next request carries instead of required.
+    """
+
+    written = None
+    required = None
+    login = None
+
+
+def _is_login(url):
+    """Tell whether url is the login endpoint of a Vault auth method."""
+    path = urllib.parse.urlsplit(url).path
+    return '/v1/auth/' in path and path.endswith('/login')
+
+
+class _StorageIndexAdapter(requests.adapters.HTTPAdapter):
+    """Carry the Vault storage index from a write to the reads after it.
+
+    The adapter is mounted on the session of the castellan key manager, so
+    it sees every request castellan sends: the write of a secret, the read
+    of a secret, and the AppRole login that castellan runs right before
+    either when its cached token is missing or expired.
+    """
+
+    def __init__(self, state):
+        super().__init__()
+        self._state = state
+
+    def send(self, request, **kwargs):
+        """Send the request with the index it must reach, record the reply's.
+
+        The request carries the index of a login that ran right before it,
+        or else the index of the secret it reads. OpenBao accepts a single
+        index, and the login's is the later one: every index a caller holds
+        was issued before the login ran.
+        """
+        state = self._state
+        index = state.login or state.required
+        state.login = None
+        if index:
+            request.headers[INDEX_HEADER] = index
+            request.headers[INCONSISTENT_HEADER] = FORWARD_ACTIVE_NODE
+
+        response = super().send(request, **kwargs)
+
+        if request.method == 'POST':
+            returned = response.headers.get(INDEX_HEADER) or None
+            if not _is_login(request.url):
+                state.written = returned
+            elif response.status_code == 200:
+                state.login = returned
+        return response
+
+
 class VaultSecretStore(css.CastellanSecretStore):
 
+    VAULT_INDEX = 'vault_index'
+
     def __init__(self, conf=CONF):
         """Constructor - create the vault secret store."""
         vault_conf = self.get_conf(conf)
         self._set_params(vault_conf)
+        self._index_state = _StorageIndexState()
+        session = getattr(self.key_manager, '_session', None)
+        if isinstance(session, requests.Session):
+            adapter = _StorageIndexAdapter(self._index_state)
+            session.mount('https://', adapter)
+            session.mount('http://', adapter)
+        else:
+            LOG.warning("Vault storage index tracking is disabled: the "
+                        "castellan key manager exposes no requests session")
+
+    def _meta_dict(self, key_id, bit_length=None, algorithm=None):
+        """Return the metadata dict, with the storage index of the write.
+
+        store_secret, generate_symmetric_key and generate_asymmetric_key
+        build their result after their last write, so the index of the
+        last write on this thread is the one that stored key_id. For a key
+        pair it is the index of the second write, which covers the first.
+        An index the metadata column cannot hold, or one requests cannot
+        send back, is not recorded.
+        """
+        meta = super()._meta_dict(key_id, bit_length, algorithm)
+        index = self._index_state.written
+        if index is None:
+            return meta
+        if len(index) > MAX_INDEX_LENGTH:
+            LOG.warning("Not recording the Vault storage index of secret "
+                        "%s: it is longer than %d characters",
+                        key_id, MAX_INDEX_LENGTH)
+        elif not _INDEX_CHARS.fullmatch(index):
+            LOG.warning("Not recording the Vault storage index of secret "
+                        "%s: it is not printable ASCII without whitespace",
+                        key_id)
+        else:
+            meta[self.VAULT_INDEX] = index
+        return meta
+
+    def get_secret(self, secret_type, secret_metadata):
+        """Read the secret from a node that has applied its write.
+
+        A secret stored with a storage index is read with that index, so
+        that a standby which has not applied the write yet forwards the
+        read to the active node. A secret without one is read as before.
+        """
+        self._index_state.required = secret_metadata.get(self.VAULT_INDEX)
+        try:
+            return super().get_secret(secret_type, secret_metadata)
+        finally:
+            self._index_state.required = None
 
     def get_plugin_name(self):
         return "VaultSecretStore"
