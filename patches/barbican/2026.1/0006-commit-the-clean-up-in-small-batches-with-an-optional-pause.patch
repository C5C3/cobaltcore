+    def test_run_batches_reads_on_after_the_last_id_of_a_batch(self):
+        """Each batch reads the ids after the last id of the batch before.
+
+        _keep leaves every row in place, so a batch that read from the
+        first row again would read the ids of the batch before it.
+        """
+        ids = sorted(_committed_soft_deleted_transport_keys(5))
+        batches = []
+
+        def _keep(session, chunk):
+            batches.append(list(chunk))
+            if len(batches) > 3:
+                self.fail('batches read the same ids again: %s' % batches)
+            return 0
+
+        def _id_query(session):
+            return session.query(models.TransportKey.id).filter_by(
+                deleted=True)
+
+        total = clean._run_batches('TransportKey', _id_query, _keep, 2)
+
+        self.assertEqual(0, total)
+        self.assertEqual([ids[0:2], ids[2:4], ids[4:]], batches)
+        self.assertEqual(5, _transport_keys_left(ids))
