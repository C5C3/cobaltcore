+class GetSessionTimeoutTestCase(test.TestCase):
+
+    @override_settings(OPENSTACK_REQUEST_TIMEOUT=7)
+    def test_get_session_takes_the_request_timeout(self):
+        self.assertEqual(7, utils.get_session().timeout)
+
+    @override_settings(OPENSTACK_REQUEST_TIMEOUT=7)
+    def test_get_session_keeps_the_timeout_of_the_caller(self):
+        self.assertEqual(3, utils.get_session(timeout=3).timeout)
+
+    def test_get_session_without_a_request_timeout(self):
+        self.assertIsNone(utils.get_session().timeout)
