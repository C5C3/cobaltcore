      "groupName": "prometheus-operator charts"
    },
    {
      "description": "The two charts whose floor follows every release: an in-range release rewrites the floor, a major rewrites both bounds",
      "matchManagers": ["flux"],
      "matchPackageNames": ["docker.io/envoyproxy/gateway-helm", "headlamp"],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": ["flux"],
      "matchFileNames": ["deploy/kind/base/envoy-gateway.yaml"],
      "matchPackageNames": ["docker.io/envoyproxy/gateway-helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "groupName": "envoy-gateway"
    },
    {
      "matchManagers": ["flux"],
      "matchFileNames": ["deploy/kind/base/headlamp.yaml"],
      "matchPackageNames": ["headlamp"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "groupName": "headlamp"
    },
    {
      "matchManagers": ["flux"],
      "matchFileNames": ["deploy/kind/nfs/release.yaml"],
      "matchPackageNames": ["csi-driver-nfs"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["flux"],
      "matchFileNames": ["deploy/kind/nfs/release.yaml"],
      "matchPackageNames": ["csi-driver-nfs"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false,
      "minimumReleaseAge": "3 days",
      "groupName": "csi-driver-nfs chart"
    },
    {
      "matchManagers": ["flux"],
      "matchFileNames": ["deploy/lab/metal-stack/ceph/release.yaml"],
      "matchPackageNames": ["rook-ceph"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "The Rook operator of the lab Ceph: a privileged operator with the ceph.rook.io CRDs, pinned to one version; a minor changes the Ceph versions it supports, so nothing automerges",
      "matchManagers": ["flux"],
      "matchFileNames": ["deploy/lab/metal-stack/ceph/release.yaml"],
      "matchPackageNames": ["rook-ceph"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false,
      "minimumReleaseAge": "3 days",
      "groupName": "rook-ceph chart"
    }
  ]
}
