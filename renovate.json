{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "nix/locks/**"
  ],
  "platformAutomerge": false,
  "postUpdateOptions": ["gomodTidy", "gomodTidyAll"],
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "automerge": false,
      "schedule": ["before 6am on monday"]
    }
  },
  "flux": {
    "managerFilePatterns": [
      "/^deploy/flux-system/(releases|sources)/.+\\.yaml$/",
      "/^deploy/kind/.+\\.yaml$/",
      "/^deploy/lab/metal-stack/ceph/(release|source)\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/releases/.*/source-refs\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^(?<depName>[\\w.-]+):\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "git-tags",
      "packageNameTemplate": "https://opendev.org/openstack/{{{depName}}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/releases/.*/test-refs\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^(?<depName>[\\w.-]+):\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/overrides/.*/constraints\\.txt$/"
      ],
      "matchStrings": [
        "(?m)^(?<depName>[\\w.-]+)===(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/hack/deploy-infra\\.sh$/",
        "/hack/deploy-mgmt-cluster\\.sh$/"
      ],
      "matchStrings": [
        "FLUX_OPERATOR_VERSION=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "controlplaneio-fluxcd/flux-operator",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "controlplaneio-fluxcd/flux-operator",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/hack/deploy-infra\\.sh$/"
      ],
      "matchStrings": [
        "GATEWAY_API_VERSION=\"\\$\\{GATEWAY_API_VERSION:-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\}\""
      ],
      "depNameTemplate": "kubernetes-sigs/gateway-api",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes-sigs/gateway-api",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/hack/deploy-infra\\.sh$/"
      ],
      "matchStrings": [
        "ENVOY_GATEWAY_VERSION=\"\\$\\{ENVOY_GATEWAY_VERSION:-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\}\""
      ],
      "depNameTemplate": "envoyproxy/gateway",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "envoyproxy/gateway",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/hack/deploy-infra\\.sh$/"
      ],
      "matchStrings": [
        "REGISTRY_CACHE_IMAGE=\"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/hack/install-test-deps\\.sh$/"
      ],
      "matchStrings": [
        "CHAINSAW_VERSION=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "kyverno/chainsaw",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kyverno/chainsaw",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/hack/install-test-deps\\.sh$/"
      ],
      "matchStrings": [
        "FLUX_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "fluxcd/flux2",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/hack/install-test-deps\\.sh$/"
      ],
      "matchStrings": [
        "KIND_VERSION=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes-sigs/kind",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/hack/install-test-deps\\.sh$/"
      ],
      "matchStrings": [
        "KUBECTL_VERSION=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/hack/dizzy\\.sh$/"
      ],
      "matchStrings": [
        "DIZZY_VERSION=\"\\$\\{DIZZY_VERSION:-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\}\""
      ],
      "depNameTemplate": "B42Labs/dizzy",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "B42Labs/dizzy",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/deploy/kind/base/flux-web\\.yaml$/"
      ],
      "matchStrings": [
        "- version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "controlplaneio-fluxcd/flux-operator",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "controlplaneio-fluxcd/flux-operator",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/deploy/flux-system/sources/k-orc\\.yaml$/"
      ],
      "matchStrings": [
        "commit:\\s*(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "https://github.com/k-orc/openstack-resource-controller",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/k-orc/openstack-resource-controller"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/deploy/flux-system/sources/openbao-operator\\.yaml$/"
      ],
      "matchStrings": [
        "tag: \"(?<currentValue>[^\"]+)\"\\n\\s*digest: \"(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "depNameTemplate": "ghcr.io/dc-tec/charts/openbao-operator",
      "datasourceTemplate": "docker",
      "packageNameTemplate": "ghcr.io/dc-tec/charts/openbao-operator",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/deploy/flux-system/sources/rabbitmq-cluster-operator\\.yaml$/"
      ],
      "matchStrings": [
        "tag: \"(?<currentValue>v[^\"]+)\"\\n\\s*commit: \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "depNameTemplate": "rabbitmq/cluster-operator",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "rabbitmq/cluster-operator",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/deploy/flux-system/releases/rabbitmq-cluster-operator\\.yaml$/"
      ],
      "matchStrings": [
        "newTag: \"(?<currentValue>[^\"]+)\"\\n\\s*digest: \"(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "depNameTemplate": "ghcr.io/rabbitmq/cluster-operator",
      "datasourceTemplate": "docker",
      "packageNameTemplate": "ghcr.io/rabbitmq/cluster-operator",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/deploy/flux-system/sources/messaging-topology-operator\\.yaml$/"
      ],
      "matchStrings": [
        "tag: \"(?<currentValue>v[^\"]+)\"\\n\\s*commit: \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "depNameTemplate": "rabbitmq/messaging-topology-operator",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "rabbitmq/messaging-topology-operator",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/deploy/flux-system/releases/messaging-topology-operator\\.yaml$/"
      ],
      "matchStrings": [
        "newTag: \"(?<currentValue>[^\"]+)\"\\n\\s*digest: \"(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "depNameTemplate": "ghcr.io/rabbitmq/messaging-topology-operator",
      "datasourceTemplate": "docker",
      "packageNameTemplate": "ghcr.io/rabbitmq/messaging-topology-operator",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/deploy/kind/infrastructure/openbao-instance\\.yaml$/"
      ],
      "matchStrings": [
        "\\n  version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "openbao/openbao",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "openbao/openbao",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/operators/c5c3/internal/controller/reconcile_barbican_openbao\\.go$/"
      ],
      "matchStrings": [
        "defaultOpenBaoVersion = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "openbao/openbao",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "openbao/openbao",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/Makefile$/",
        "/\\.github/workflows/.*\\.yaml$/"
      ],
      "matchStrings": [
        "GOFUMPT_VERSION\\s*[?=:]+\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "mvdan/gofumpt",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "mvdan/gofumpt",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "ENVTEST_K8S_VERSION\\s*\\?=\\s*(?<currentValue>\\d+\\.\\d+)\\s"
      ],
      "depNameTemplate": "envtest",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes-sigs/controller-tools",
      "extractVersionTemplate": "^envtest-v(?<version>\\d+\\.\\d+)\\.\\d+$",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.yaml$/"
      ],
      "matchStrings": [
        "CONTROLLER_GEN_VERSION:\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "kubernetes-sigs/controller-tools",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes-sigs/controller-tools",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.yaml$/"
      ],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION:\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "golangci/golangci-lint",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.yaml$/"
      ],
      "matchStrings": [
        "KIND_VERSION:\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes-sigs/kind",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.yaml$/"
      ],
      "matchStrings": [
        "YQ_VERSION:\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "mikefarah/yq",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "mikefarah/yq",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.yaml$/"
      ],
      "matchStrings": [
        "ACTIONLINT_VERSION:\\s*\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "rhysd/actionlint",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/tests/e2e/keystone/ldap-domain-backend/00-openldap\\.yaml$/",
        "/tests/e2e-controlplane-sso/01-openldap\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>ghcr\\.io/rroemhild/docker-test-openldap):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/tests/e2e/keystone/oidc-federation/00-keycloak\\.yaml$/",
        "/tests/e2e/keystone/saml-federation/00-keycloak-saml\\.yaml$/",
        "/tests/e2e-chaos/keystone-federation/00-keycloak\\.yaml$/",
        "/tests/e2e-controlplane-sso/00-keycloak\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>quay\\.io/keycloak/keycloak):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/tests/e2e/infrastructure/garage-health/chainsaw-test\\.yaml$/"
      ],
      "matchStrings": [
        "image=(?<depName>public\\.ecr\\.aws/aws-cli/aws-cli):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/deploy/kind/nfs/nfs-server\\.yaml$/",
        "/tests/e2e/infrastructure/nfs-health/chainsaw-test\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>ghcr\\.io/kubernetes-sigs/nfs-ganesha):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^V(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/deploy/lab/metal-stack/probe/node-probe\\.yaml$/",
        "/deploy/lab/metal-stack/migration-ports/reservation-daemonset\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>docker\\.io/library/debian):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/deploy/lab/metal-stack/dizzy-soak/job\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>docker\\.io/alpine/k8s):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Lab libvirt image: the keeper tag <libvirt-version>-r<N> the Nix-built image gets on main (hack/ci-tag-libvirt-keeper.sh) with its digest, in the eight pins of the lab manifests",
      "managerFilePatterns": [
        "/deploy/lab/metal-stack/hypervisor/libvirt-daemonset\\.yaml$/",
        "/deploy/lab/metal-stack/probe/nfs-module-load\\.yaml$/",
        "/deploy/lab/metal-stack/nfs/client-modules-daemonset\\.yaml$/",
        "/deploy/lab/metal-stack/chaos-mesh/modules-daemonset\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>ghcr\\.io/c5c3/libvirt):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "deb"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/tests/unit/renovate/.*_test\\.sh$/"
      ],
      "matchStrings": [
        "RENOVATE_VALIDATOR_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
      "packageNameTemplate": "renovate",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "OVN image: the OVN tag and the commit it names in images/ovn/source.json, moved together; make nix-lock then writes their hashes and the ovs gitlink with its hash",
      "managerFilePatterns": [
        "/images/ovn/source\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\",\\s*\"rev\":\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "depNameTemplate": "ovn-org/ovn",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "ovn-org/ovn",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "openstack-hypervisor-operator image: a commit of upstream main in images/openstack-hypervisor-operator/source.json, tracked as a digest of the branch; make nix-lock then writes its hash and vendorHash",
      "managerFilePatterns": [
        "/images/openstack-hypervisor-operator/source\\.json$/"
      ],
      "matchStrings": [
        "\"rev\":\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "https://github.com/cobaltcore-dev/openstack-hypervisor-operator",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/cobaltcore-dev/openstack-hypervisor-operator"
    },
    {
      "customType": "regex",
      "description": "kvm-node-agent image: a commit of upstream main in images/kvm-node-agent/source.json, tracked as a digest of the branch; make nix-lock then writes its hash and vendorHash",
      "managerFilePatterns": [
        "/images/kvm-node-agent/source\\.json$/"
      ],
      "matchStrings": [
        "\"rev\":\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "https://github.com/cobaltcore-dev/kvm-node-agent",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/cobaltcore-dev/kvm-node-agent"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/operators/ovn/internal/controller/image\\.go$/"
      ],
      "matchStrings": [
        "defaultOVNVersion = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "ovn-org/ovn",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "ovn-org/ovn",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "noVNC console assets of the nova image, pinned in images/nova/novnc.json: the tag and the commit it names move together, and make nix-lock then writes the hash of the new commit into the same file",
      "managerFilePatterns": [
        "/images/nova/novnc\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\",\\s*\"rev\":\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "depNameTemplate": "novnc/noVNC",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "novnc/noVNC",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "mod_auth_openidc of the keystone-federation-proxy image, pinned in images/keystone-federation-proxy/source.json: the tag and the commit it names move together, and make nix-lock then writes the hash of the new commit into the same file",
      "managerFilePatterns": [
        "/images/keystone-federation-proxy/source\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?)\",\\s*\"rev\":\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "depNameTemplate": "OpenIDC/mod_auth_openidc",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "OpenIDC/mod_auth_openidc",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$"
    },
    {
      "customType": "regex",
      "description": "Ceph image of the lab Ceph: the CephCluster and the toolbox run the same tag and digest",
      "managerFilePatterns": [
        "/deploy/lab/metal-stack/ceph/cluster/cluster\\.yaml$/",
        "/deploy/lab/metal-stack/ceph/cluster/toolbox\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>quay\\.io/ceph/ceph):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["releases/**/source-refs.yaml"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["releases/**/source-refs.yaml"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days",
