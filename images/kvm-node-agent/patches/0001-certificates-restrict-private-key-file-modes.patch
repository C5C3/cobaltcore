+
+package certificates
+
+import (
+	"bytes"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+)
+
+var testKey = []byte("private key\n")
+
+func testSecretData() map[string][]byte {
+	return map[string][]byte{
+		"ca.crt":  []byte("ca certificate\n"),
+		"tls.crt": []byte("server certificate\n"),
+		"tls.key": testKey,
+	}
+}
+
+// usePKI points the package at a new PKI directory with PKI_KEY_GROUP set to
+// group, and restores both when the test ends.
+func usePKI(t *testing.T, group string) string {
+	t.Helper()
+	oldPKI, oldKeyGroup := pki, keyGroup
+	t.Cleanup(func() { pki, keyGroup = oldPKI, oldKeyGroup })
+	pki, keyGroup = t.TempDir(), group
+	return pki
+}
+
+// regularFiles returns the sorted paths, relative to dir, of the regular
+// files under dir.
+func regularFiles(t *testing.T, dir string) []string {
+	t.Helper()
+	var files []string
+	err := filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
+		if err != nil || !d.Type().IsRegular() {
+			return err
+		}
+		rel, err := filepath.Rel(dir, path)
+		files = append(files, rel)
+		return err
+	})
+	if err != nil {
+		t.Fatalf("walking %s: %v", dir, err)
+	}
+	slices.Sort(files)
+	return files
+}
+
+// assertNoTemporaryFile fails the test for a regular file under dir whose
+// name starts with a dot, the prefix of stageFile's temporary files.
+func assertNoTemporaryFile(t *testing.T, dir string) {
+	t.Helper()
+	for _, file := range regularFiles(t, dir) {
+		if strings.HasPrefix(filepath.Base(file), ".") {
+			t.Errorf("temporary file %s was left behind", file)
+		}
+	}
+}
+
+// assertKeyModes walks the PKI directory dir. A private key file must have
+// mode 0600 and the group of its directory; with a key group, the keys of
+// QEMU and Cloud Hypervisor must have mode 0640 and that group instead. Any
+// other regular file must have mode 0644, and a regular file that holds the
+// private key but is not a key target of secretToFileMap fails the test.
+func assertKeyModes(t *testing.T, dir string, keyGID int) {
+	t.Helper()
+	keyTargets := secretToFileMap[privateKeySource]
+	keys := 0
+	for _, file := range regularFiles(t, dir) {
+		path := filepath.Join(dir, file)
+		info, err := os.Stat(path)
+		if err != nil {
+			t.Fatalf("stat %s: %v", file, err)
+		}
+		mode := info.Mode().Perm()
+		if !slices.Contains(keyTargets, file) {
+			content, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatalf("reading %s: %v", file, err)
+			}
+			if bytes.Equal(content, testKey) {
+				t.Errorf("%s holds the private key but is not a key target", file)
+			} else if mode != 0644 {
+				t.Errorf("%s has mode %#o, want 0644", file, mode)
+			}
+			continue
+		}
+		keys++
+		dirInfo, err := os.Stat(filepath.Dir(path))
+		if err != nil {
+			t.Fatalf("stat the directory of %s: %v", file, err)
+		}
+		wantMode, wantGID := os.FileMode(0600), int(dirInfo.Sys().(*syscall.Stat_t).Gid)
+		if keyGID != noGroup && (file == "qemu/server-key.pem" || file == "ch/server-key.pem") {
+			wantMode, wantGID = 0640, keyGID
+		}
+		if mode != wantMode {
+			t.Errorf("%s has mode %#o, want %#o", file, mode, wantMode)
+		}
+		if gid := int(info.Sys().(*syscall.Stat_t).Gid); gid != wantGID {
+			t.Errorf("%s has group %d, want %d", file, gid, wantGID)
+		}
+	}
+	if keys != len(keyTargets) {
+		t.Errorf("found %d private key files, want %d", keys, len(keyTargets))
+	}
+}
+
+// permittedGroup returns a group that the process may give its files: 4242
+// as root, otherwise one of its own groups.
+func permittedGroup(t *testing.T) int {
+	t.Helper()
+	if os.Geteuid() == 0 {
+		return 4242
+	}
+	groups, err := os.Getgroups()
+	if err != nil {
+		t.Fatalf("listing the process's groups: %v", err)
+	}
+	for _, gid := range groups {
+		if gid != os.Getegid() {
+			return gid
+		}
+	}
+	return os.Getegid()
+}
+
+func TestUpdateTLSCertificateKeyMode(t *testing.T) {
+	t.Run("new files", func(t *testing.T) {
+		dir := usePKI(t, "")
+		if err := UpdateTLSCertificate(t.Context(), testSecretData()); err != nil {
+			t.Fatalf("UpdateTLSCertificate: %v", err)
+		}
+		assertKeyModes(t, dir, noGroup)
+	})
+
+	t.Run("existing keys with mode 0644", func(t *testing.T) {
+		dir := usePKI(t, "")
+		for _, target := range secretToFileMap[privateKeySource] {
+			path := filepath.Join(dir, target)
+			if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(path, []byte("old key\n"), 0644); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.Chmod(path, 0644); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := UpdateTLSCertificate(t.Context(), testSecretData()); err != nil {
+			t.Fatalf("UpdateTLSCertificate: %v", err)
+		}
+		assertKeyModes(t, dir, noGroup)
+	})
+
+	t.Run("second write leaves no temporary file", func(t *testing.T) {
+		dir := usePKI(t, "")
+		for range 2 {
+			if err := UpdateTLSCertificate(t.Context(), testSecretData()); err != nil {
+				t.Fatalf("UpdateTLSCertificate: %v", err)
+			}
+		}
+		var want []string
+		for _, targets := range secretToFileMap {
+			want = append(want, targets...)
+		}
+		slices.Sort(want)
+		if got := regularFiles(t, dir); !slices.Equal(got, want) {
+			t.Errorf("regular files are %q, want %q", got, want)
+		}
+		assertKeyModes(t, dir, noGroup)
+	})
+
+	t.Run("key group", func(t *testing.T) {
+		gid := permittedGroup(t)
+		dir := usePKI(t, strconv.Itoa(gid))
+		if err := UpdateTLSCertificate(t.Context(), testSecretData()); err != nil {
+			t.Fatalf("UpdateTLSCertificate: %v", err)
+		}
+		assertKeyModes(t, dir, gid)
+	})
+
+	t.Run("invalid key group", func(t *testing.T) {
+		dir := usePKI(t, "")
+		for _, value := range []string{"libvirt", "-1", " 108", "2147483648"} {
+			keyGroup = value
+			err := UpdateTLSCertificate(t.Context(), testSecretData())
+			want := "invalid PKI_KEY_GROUP " + strconv.Quote(value) + ": not a numeric group ID"
+			if err == nil || err.Error() != want {
+				t.Errorf("PKI_KEY_GROUP=%q: got error %v, want %q", value, err, want)
+			}
+			if files := regularFiles(t, dir); len(files) != 0 {
+				t.Errorf("PKI_KEY_GROUP=%q: wrote %q", value, files)
+			}
+		}
+	})
+
+	t.Run("missing private key", func(t *testing.T) {
+		dir := usePKI(t, "")
+		data := testSecretData()
+		delete(data, privateKeySource)
+		err := UpdateTLSCertificate(t.Context(), data)
+		if want := "missing data for secret key tls.key"; err == nil || err.Error() != want {
+			t.Errorf("got error %v, want %q", err, want)
+		}
+		if files := regularFiles(t, dir); len(files) != 0 {
+			t.Errorf("wrote %q", files)
+		}
+	})
+
+	t.Run("empty secret", func(t *testing.T) {
+		dir := usePKI(t, "")
+		for _, data := range []map[string][]byte{nil, {}} {
+			err := UpdateTLSCertificate(t.Context(), data)
+			if err == nil || !strings.HasPrefix(err.Error(), "missing data for secret key ") {
+				t.Errorf("data %#v: got error %v, want missing data", data, err)
+			}
+			if files := regularFiles(t, dir); len(files) != 0 {
+				t.Errorf("data %#v: wrote %q", data, files)
+			}
+		}
+	})
+
+	t.Run("directory in place of a key", func(t *testing.T) {
+		dir := usePKI(t, "")
+		target := filepath.Join(dir, "libvirt/private/serverkey.pem")
+		if err := os.MkdirAll(target, 0755); err != nil {
+			t.Fatal(err)
+		}
+		err := UpdateTLSCertificate(t.Context(), testSecretData())
+		want := "failed to write targetFile " + target + ": rename "
+		if err == nil || !strings.HasPrefix(err.Error(), want) {
+			t.Errorf("got error %v, want one starting with %q", err, want)
+		}
+		assertNoTemporaryFile(t, dir)
+	})
+}
+
+// TestUpdateTLSCertificateKeyGroupNotPermitted runs only as a user other than
+// root: a root process may give a file any group.
+func TestUpdateTLSCertificateKeyGroupNotPermitted(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("root may give a file any group")
+	}
+	groups, err := os.Getgroups()
+	if err != nil {
+		t.Fatalf("listing the process's groups: %v", err)
+	}
+	gid := 4242
+	for gid == os.Getegid() || slices.Contains(groups, gid) {
+		gid++
+	}
+	dir := usePKI(t, "")
+	previous := map[string][]byte{
+		"ca.crt":  []byte("previous ca certificate\n"),
+		"tls.crt": []byte("previous server certificate\n"),
+		"tls.key": []byte("previous private key\n"),
+	}
+	if err := UpdateTLSCertificate(t.Context(), previous); err != nil {
+		t.Fatalf("writing the previous Secret: %v", err)
+	}
+	keyGroup = strconv.Itoa(gid)
+
+	err = UpdateTLSCertificate(t.Context(), testSecretData())
+	if err == nil || !strings.Contains(err.Error(), "failed to write targetFile ") ||
+		!strings.Contains(err.Error(), "operation not permitted") {
+		t.Errorf("got error %v, want a failed write that is not permitted", err)
+	}
+	for source, targets := range secretToFileMap {
+		for _, target := range targets {
+			content, err := os.ReadFile(filepath.Join(dir, target))
+			if err != nil || !bytes.Equal(content, previous[source]) {
+				t.Errorf("%s holds %q (%v), want the previous Secret's %q", target, content, err, previous[source])
+			}
+		}
+	}
+	assertNoTemporaryFile(t, dir)
+}
