+var hypervisorKeyTargets = map[string]bool{"qemu/server-key.pem": true, "ch/server-key.pem": true}
+
+// parseKeyGroup parses the value of PKI_KEY_GROUP: empty for no group, or a
+// numeric group ID. A group name is not accepted, because the agent's image
+// may have no group database to resolve it.
+func parseKeyGroup(value string) (int, error) {
+	if value == "" {
+		return noGroup, nil
+	}
+	gid, err := strconv.ParseUint(value, 10, 31)
+	if err != nil {
+		return noGroup, fmt.Errorf("invalid PKI_KEY_GROUP %q: not a numeric group ID", value)
+	}
+	return int(gid), nil
+}
+
+// fileModeAndGroup returns the mode and group of the file that the secret key
+// source is written to at target, a path relative to the PKI directory. A
+// private key is readable by its owner only. The keys of hypervisorKeyTargets
+// are also readable by keyGID when one is set. Any other private key target,
+// including one that is added to secretToFileMap later, gets mode 0600.
+func fileModeAndGroup(source, target string, keyGID int) (mode os.FileMode, gid int) {
+	if source != privateKeySource {
+		return 0644, noGroup
+	}
+	if hypervisorKeyTargets[target] && keyGID != noGroup {
+		return 0640, keyGID
+	}
+	return 0600, noGroup
+}
+
+// stagedFile is a temporary file that holds the data of target until it is
+// renamed over target.
+type stagedFile struct {
+	tmp, target string
+}
+
+// stageFile writes data to a temporary file in the target's directory, with
+// the given mode and with the group gid unless it is noGroup, and returns its
+// name for the caller to rename over target. os.WriteFile keeps the mode of a
+// file that already exists, and changing the mode of a file that another user
+// owns needs CAP_FOWNER; the rename replaces the file whoever owns it, and no
+// reader sees a partly written file. The temporary file is created with mode
+// 0600 and gets its group before its mode, so the data is never readable by
+// more users than the result.
+func stageFile(target string, data []byte, mode os.FileMode, gid int) (string, error) {
+	tmp, err := os.CreateTemp(filepath.Dir(target), "."+filepath.Base(target)+".*")
+	if err != nil {
+		return "", err
+	}
+	if gid != noGroup {
+		err = tmp.Chown(-1, gid)
+	}
+	if err == nil {
+		err = tmp.Chmod(mode)
+	}
+	if err == nil {
+		_, err = tmp.Write(data)
+	}
+	if closeErr := tmp.Close(); err != nil || closeErr != nil {
+		return "", errors.Join(err, closeErr, os.Remove(tmp.Name()))
+	}
+	return tmp.Name(), nil
+}
