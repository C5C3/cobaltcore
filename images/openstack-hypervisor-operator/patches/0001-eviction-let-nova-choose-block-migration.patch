+package eviction
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestLiveMigrateAutoBody(t *testing.T) {
+	body, err := liveMigrateAuto{}.ToLiveMigrateMap()
+	if err != nil {
+		t.Fatalf("ToLiveMigrateMap: %v", err)
+	}
+	got, err := json.Marshal(body)
+	if err != nil {
+		t.Fatalf("marshal body: %v", err)
+	}
+	want := `{"os-migrateLive":{"block_migration":"auto","host":null}}`
+	if string(got) != want {
+		t.Errorf("os-migrateLive body = %s, want %s", got, want)
+	}
+}
