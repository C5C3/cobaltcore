+
+package eviction
+
+// liveMigrateAuto is the os-migrateLive body that leaves the choice of block
+// migration to Nova. servers.LiveMigrateOpts cannot express it: its
+// BlockMigration field is a *bool, and the compute API takes the string "auto"
+// from microversion 2.25 on.
+type liveMigrateAuto struct{}
+
+// ToLiveMigrateMap implements servers.LiveMigrateOptsBuilder.
+func (liveMigrateAuto) ToLiveMigrateMap() (map[string]any, error) {
+	return map[string]any{
+		"os-migrateLive": map[string]any{
+			"host":            nil,
+			"block_migration": "auto",
+		},
+	}, nil
+}
