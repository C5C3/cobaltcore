+package controller
+
+import (
+	"slices"
+	"testing"
+
+	"k8s.io/apimachinery/pkg/api/meta"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/types"
+	clientgoscheme "k8s.io/client-go/kubernetes/scheme"
+	ctrl "sigs.k8s.io/controller-runtime"
+	k8sclient "sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+
+	kvmv1 "github.com/cobaltcore-dev/openstack-hypervisor-operator/api/v1"
+)
+
+// TestTraitsInSyncSetsTraitsUpdated reconciles a Hypervisor whose custom
+// traits are already in sync. The TraitsController has no Placement client, so
+// any Placement call would panic.
+func TestTraitsInSyncSetsTraitsUpdated(t *testing.T) {
+	key := types.NamespacedName{Name: "hv-in-sync"}
+	otherTraits := []string{"HW_CPU_X86_VMX"}
+
+	setup := func(t *testing.T, onboardingReason string) (k8sclient.Client, *TraitsController) {
+		t.Helper()
+		scheme := runtime.NewScheme()
+		if err := clientgoscheme.AddToScheme(scheme); err != nil {
+			t.Fatalf("adding the client-go scheme: %v", err)
+		}
+		if err := kvmv1.AddToScheme(scheme); err != nil {
+			t.Fatalf("adding the kvm scheme: %v", err)
+		}
+		hv := &kvmv1.Hypervisor{
+			Name: key.Name,
+			Spec: kvmv1.HypervisorSpec{
+				LifecycleEnabled: true,
+				CustomTraits:     []string{},
+			},
+			Status: kvmv1.HypervisorStatus{
+				HypervisorID: "c3c8e8d6-0c55-4d9b-9e3c-6f1f8a0f2a11",
+				Traits:       otherTraits,
+				Conditions: []metav1.Condition{{
+					Type:               kvmv1.ConditionTypeOnboarding,
+					Status:             metav1.ConditionTrue,
+					Reason:             onboardingReason,
+					LastTransitionTime: metav1.Now(),
+				}},
+			},
+		}
+		c := fake.NewClientBuilder().WithScheme(scheme).
+			WithStatusSubresource(&kvmv1.Hypervisor{}).WithObjects(hv).Build()
+		return c, &TraitsController{Client: c, Scheme: scheme}
+	}
+
+	reconcile := func(t *testing.T, c k8sclient.Client, tc *TraitsController) *kvmv1.Hypervisor {
+		t.Helper()
+		if _, err := tc.Reconcile(t.Context(), ctrl.Request{NamespacedName: key}); err != nil {
+			t.Fatalf("Reconcile: %v", err)
+		}
+		hv := &kvmv1.Hypervisor{}
+		if err := c.Get(t.Context(), key, hv); err != nil {
+			t.Fatalf("getting the Hypervisor: %v", err)
+		}
+		return hv
+	}
+
+	t.Run("Handover sets TraitsUpdated", func(t *testing.T) {
+		c, tc := setup(t, kvmv1.ConditionReasonHandover)
+		hv := reconcile(t, c, tc)
+
+		cond := meta.FindStatusCondition(hv.Status.Conditions, kvmv1.ConditionTypeTraitsUpdated)
+		if cond == nil {
+			t.Fatalf("no %s condition", kvmv1.ConditionTypeTraitsUpdated)
+		}
+		if cond.Status != metav1.ConditionTrue || cond.Reason != kvmv1.ConditionReasonSucceeded ||
+			cond.Message != "Custom traits are in sync" {
+			t.Errorf("%s = %s/%s %q, want True/%s %q", cond.Type, cond.Status, cond.Reason, cond.Message,
+				kvmv1.ConditionReasonSucceeded, "Custom traits are in sync")
+		}
+		if !slices.Equal(hv.Status.Traits, otherTraits) {
+			t.Errorf("status.traits = %v, want %v unchanged", hv.Status.Traits, otherTraits)
+		}
+	})
+
+	t.Run("a repeat writes nothing", func(t *testing.T) {
+		c, tc := setup(t, kvmv1.ConditionReasonHandover)
+		first := reconcile(t, c, tc)
+		second := reconcile(t, c, tc)
+		if second.ResourceVersion != first.ResourceVersion {
+			t.Errorf("resourceVersion moved from %s to %s on a repeat", first.ResourceVersion, second.ResourceVersion)
+		}
+	})
+
+	t.Run("Testing sets no condition", func(t *testing.T) {
+		c, tc := setup(t, kvmv1.ConditionReasonTesting)
+		hv := reconcile(t, c, tc)
+		if cond := meta.FindStatusCondition(hv.Status.Conditions, kvmv1.ConditionTypeTraitsUpdated); cond != nil {
+			t.Errorf("%s set during Testing: %s/%s", cond.Type, cond.Status, cond.Reason)
+		}
+	})
+}
