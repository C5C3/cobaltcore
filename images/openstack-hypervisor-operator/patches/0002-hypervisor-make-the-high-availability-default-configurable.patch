+package controller
+
+import (
+	"testing"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/types"
+	clientgoscheme "k8s.io/client-go/kubernetes/scheme"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+
+	kvmv1 "github.com/cobaltcore-dev/openstack-hypervisor-operator/api/v1"
+	"github.com/cobaltcore-dev/openstack-hypervisor-operator/internal/global"
+)
+
+// TestHypervisorCreatedWithDefaultHighAvailability reconciles a Node without
+// a Hypervisor and reads spec.highAvailability off the Hypervisor the
+// controller creates. The subtests share the package variable, so they do not
+// run in parallel.
+func TestHypervisorCreatedWithDefaultHighAvailability(t *testing.T) {
+	createdSpec := func(t *testing.T) kvmv1.HypervisorSpec {
+		t.Helper()
+		scheme := runtime.NewScheme()
+		if err := clientgoscheme.AddToScheme(scheme); err != nil {
+			t.Fatalf("adding the client-go scheme: %v", err)
+		}
+		if err := kvmv1.AddToScheme(scheme); err != nil {
+			t.Fatalf("adding the kvm scheme: %v", err)
+		}
+		node := &corev1.Node{Name: "node-a"}
+		c := fake.NewClientBuilder().WithScheme(scheme).WithObjects(node).Build()
+		hc := &HypervisorController{Client: c, Scheme: scheme}
+
+		key := types.NamespacedName{Name: "node-a"}
+		if _, err := hc.Reconcile(t.Context(), ctrl.Request{NamespacedName: key}); err != nil {
+			t.Fatalf("Reconcile: %v", err)
+		}
+		hv := &kvmv1.Hypervisor{}
+		if err := c.Get(t.Context(), key, hv); err != nil {
+			t.Fatalf("getting the created Hypervisor: %v", err)
+		}
+		if !hv.Spec.InstallCertificate {
+			t.Errorf("spec.installCertificate = false, want true")
+		}
+		return hv.Spec
+	}
+
+	t.Run("default", func(t *testing.T) {
+		if spec := createdSpec(t); !spec.HighAvailability {
+			t.Errorf("spec.highAvailability = false, want true")
+		}
+	})
+
+	t.Run("flag set to false", func(t *testing.T) {
+		previous := global.DefaultHighAvailability
+		global.DefaultHighAvailability = false
+		t.Cleanup(func() { global.DefaultHighAvailability = previous })
+
+		if spec := createdSpec(t); spec.HighAvailability {
+			t.Errorf("spec.highAvailability = true, want false")
+		}
+	})
+}
