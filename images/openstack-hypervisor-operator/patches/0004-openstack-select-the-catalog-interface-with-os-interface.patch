+package openstack
+
+import (
+	"errors"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/gophercloud/gophercloud/v2"
+)
+
+// TestServiceClientInterface builds a compute client on a provider whose
+// endpoint locator records the options it gets, and reads the catalog
+// interface OS_INTERFACE selected off them. The subtests share the process
+// environment, so they do not run in parallel.
+func TestServiceClientInterface(t *testing.T) {
+	const endpoint = "http://controlplane-nova.openstack.svc:8774/v2.1/"
+
+	// serviceClient returns the client, the options of every locator call and
+	// the error. A nil locErr makes the locator return endpoint.
+	serviceClient := func(t *testing.T, locErr error) (*gophercloud.ServiceClient, []gophercloud.EndpointOpts, error) {
+		t.Helper()
+		var seen []gophercloud.EndpointOpts
+		provider := &gophercloud.ProviderClient{
+			EndpointLocator: func(eo gophercloud.EndpointOpts) (string, error) {
+				seen = append(seen, eo)
+				if locErr != nil {
+					return "", locErr
+				}
+				return endpoint, nil
+			},
+		}
+		client, err := ServiceClientFromProvider(provider, "compute")
+		return client, seen, err
+	}
+
+	for _, tc := range []struct {
+		name  string
+		value string
+		unset bool
+		want  gophercloud.Availability
+	}{
+		{name: "unset keeps public", unset: true, want: gophercloud.AvailabilityPublic},
+		{name: "empty keeps public", value: "", want: gophercloud.AvailabilityPublic},
+		{name: "public", value: "public", want: gophercloud.AvailabilityPublic},
+		{name: "internal", value: "internal", want: gophercloud.AvailabilityInternal},
+		{name: "admin", value: "admin", want: gophercloud.AvailabilityAdmin},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			// t.Setenv restores an ambient value after the test, so the
+			// unset case removes it only for this subtest.
+			t.Setenv("OS_INTERFACE", tc.value)
+			if tc.unset {
+				if err := os.Unsetenv("OS_INTERFACE"); err != nil {
+					t.Fatalf("unsetting OS_INTERFACE: %v", err)
+				}
+			}
+			client, seen, err := serviceClient(t, nil)
+			if err != nil {
+				t.Fatalf("ServiceClientFromProvider: %v", err)
+			}
+			if len(seen) != 1 {
+				t.Fatalf("endpoint locator called %d times, want 1", len(seen))
+			}
+			if seen[0].Availability != tc.want {
+				t.Errorf("Availability = %q, want %q", seen[0].Availability, tc.want)
+			}
+			if client.Endpoint != endpoint {
+				t.Errorf("Endpoint = %q, want %q", client.Endpoint, endpoint)
+			}
+		})
+	}
+
+	// The value is matched as given: another case, surrounding whitespace and
+	// the internalURL spelling of the Keystone v2 catalog are unknown values.
+	for _, value := range []string{"Internal", " internal", "internal\n", "internalURL"} {
+		t.Run("unknown value "+strconv.Quote(value)+" is an error before the locator runs", func(t *testing.T) {
+			t.Setenv("OS_INTERFACE", value)
+			_, seen, err := serviceClient(t, nil)
+			want := "OS_INTERFACE: unknown interface " + strconv.Quote(value)
+			if err == nil || !strings.Contains(err.Error(), want) {
+				t.Errorf("error = %v, want one containing %s", err, want)
+			}
+			if len(seen) != 0 {
+				t.Errorf("endpoint locator called %d times, want 0", len(seen))
+			}
+		})
+	}
+
+	t.Run("locator error is returned unchanged", func(t *testing.T) {
+		t.Setenv("OS_INTERFACE", "internal")
+		notFound := &gophercloud.ErrEndpointNotFound{}
+		_, _, err := serviceClient(t, notFound)
+		// A wrapper keeps errors.Is true but changes the text.
+		if !errors.Is(err, notFound) || err.Error() != notFound.Error() {
+			t.Errorf("error = %v, want the locator's %T unchanged", err, notFound)
+		}
+	})
+}
