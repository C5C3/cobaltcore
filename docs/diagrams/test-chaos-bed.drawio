        <mxCell id="test-chaos-bed-105" value="The packet arrives with its destination rewritten and with the address of the client pod as its source. The rule matches and drops it." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="1575" width="1182" height="28" as="geometry"/></mxCell>
        <mxCell id="test-chaos-bed-106" value="A numbered box is a step of a suite, in the order chainsaw runs them. The list on the page describes every step under its number." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1657" width="1164" height="28" as="geometry"/></mxCell>
        <mxCell id="test-chaos-bed-107" value="{cluster-ip}: the ClusterIP of the Service the client dials. {server-ip}, {client-ip}: pod addresses. Chaos Mesh puts a rule into the pods of selector and matches the pods of target by address." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1691" width="1682" height="28" as="geometry"/></mxCell>
        <mxCell id="test-chaos-bed-108" value="The partition suites select the server pods and name the client pods as target, with direction both." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1725" width="888" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
