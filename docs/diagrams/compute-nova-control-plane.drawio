        <mxCell id="compute-nova-control-plane-51" value="its only connection" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1099.5" y="959" width="181" height="24" as="geometry"/></mxCell>
        <mxCell id="compute-nova-control-plane-52" value="{nova}: the Nova resource, {cp}-nova under a ControlPlane. {host}: a compute host." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1135" width="752" height="28" as="geometry"/></mxCell>
        <mxCell id="compute-nova-control-plane-53" value="The schema names are the ones a ControlPlane sets. A standalone Nova names them in spec.apiDatabase.database and spec.database.database; cell0 is that name plus _cell0." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1161" width="1590" height="28" as="geometry"/></mxCell>
        <mxCell id="compute-nova-control-plane-54" value="A connection string reaches its process as an environment variable, never in the ConfigMap." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1187" width="831" height="28" as="geometry"/></mxCell>
