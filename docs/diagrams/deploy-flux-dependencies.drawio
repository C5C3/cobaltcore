        <mxCell id="deploy-flux-dependencies-51" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;dashed=1;dashPattern=1 3;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="448" y="1186" as="sourcePoint"/><mxPoint x="1480" y="824" as="targetPoint"/><Array as="points"><mxPoint x="1480" y="1186"/></Array></mxGeometry></mxCell>
        <mxCell id="deploy-flux-dependencies-52" value="the manager starts only with the K-ORC CRDs" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#2B3440;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="508" y="1124" width="458" height="24" as="geometry"/></mxCell>
        <mxCell id="deploy-flux-dependencies-53" value="install retries: 30" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="508" y="1150" width="165" height="28" as="geometry"/></mxCell>
        <mxCell id="deploy-flux-dependencies-54" value="A pill is a HelmRelease of deploy/flux-system/releases, under its metadata.name. The three in the box Flux Kustomizations are Flux Kustomization resources." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1268" width="1522" height="28" as="geometry"/></mxCell>
        <mxCell id="deploy-flux-dependencies-55" value="A solid arrow is a dependsOn entry. An entry that other arrows imply is left out. The table on the page lists every entry." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1294" width="1155" height="28" as="geometry"/></mxCell>
        <mxCell id="deploy-flux-dependencies-56" value="A dotted arrow holds at run time and is declared nowhere: dependsOn of a HelmRelease names only HelmReleases, dependsOn of a Kustomization only Kustomizations." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="1658" height="28" as="geometry"/></mxCell>
        <mxCell id="deploy-flux-dependencies-58" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="274" y="1098" as="sourcePoint"/><mxPoint x="274" y="1058" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
