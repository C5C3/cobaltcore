        <mxCell id="service-satellite-handshake-7" value="what the satellite needs for its work" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="254" width="333" height="28" as="geometry"/></mxCell>
