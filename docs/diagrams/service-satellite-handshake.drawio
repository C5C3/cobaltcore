        <mxCell id="service-satellite-handshake-9" value="ConfigProjected" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=1;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="672" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-10" value="Ready" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=1;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="440" y="838" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-11" value="aggregation step" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=1;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1140" y="300" width="250" height="56" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-12" value="a step in the pipeline of {svc}" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1406" y="314" width="270" height="28" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-13" value="&lt;span style=&quot;font-weight:600&quot;&gt;rendered Secret&lt;/span&gt;" style="shape=note;size=16;fillColor=#F7E8F0;strokeColor=#B0387F;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#8A2B63;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1140" y="486" width="250" height="56" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-14" value="one section per satellite that passed" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1406" y="488" width="338" height="28" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-15" value="its name carries a hash of its content" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1406" y="514" width="341" height="28" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-16" value="&lt;span style=&quot;font-weight:600&quot;&gt;Deployment of {svc}&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=34;fillColor=#FDFCF9;strokeColor=#2457C5;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#1D47A6;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1140" y="672" width="250" height="56" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-17" value="the pod template mounts" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1406" y="674" width="240" height="28" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-18" value="the rendered Secret" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1406" y="700" width="191" height="28" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-19" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="218" as="sourcePoint"/><mxPoint x="555" y="300" as="targetPoint"/><Array as="points"><mxPoint x="555" y="218"/></Array></mxGeometry></mxCell>
        <mxCell id="service-satellite-handshake-20" value="1" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="318" y="200" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-21" value="the controller checks them" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#2B3440;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="362" y="188" width="253" height="24" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-22" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="328" as="sourcePoint"/><mxPoint x="1140" y="328" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="service-satellite-handshake-23" value="2" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="678" y="310" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-24" value="reads only this condition" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#2B3440;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="736" y="298" width="232" height="24" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-25" value="" style="edgeStyle=none;rounded=0;strokeColor=#2F8A57;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1265" y="356" as="sourcePoint"/><mxPoint x="1265" y="486" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="service-satellite-handshake-26" value="3" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1247" y="364" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-27" value="renders" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#2B3440;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1281" y="425" width="82" height="24" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-28" value="" style="edgeStyle=none;rounded=0;strokeColor=#B0387F;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1265" y="542" as="sourcePoint"/><mxPoint x="1265" y="672" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="service-satellite-handshake-29" value="4" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1247" y="550" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-30" value="mount" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#8A2B63;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1291" y="597" width="71" height="24" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-31" value="a new name rolls the pods" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1291" y="621" width="248" height="28" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-32" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="700" as="sourcePoint"/><mxPoint x="670" y="700" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="service-satellite-handshake-33" value="5" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1096" y="682" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-34" value="finds its section in the mounted Secret" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#2B3440;align=right;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="711" y="670" width="357" height="24" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-35" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="340" as="sourcePoint"/><mxPoint x="440" y="866" as="targetPoint"/><Array as="points"><mxPoint x="400" y="340"/><mxPoint x="400" y="866"/></Array></mxGeometry></mxCell>
        <mxCell id="service-satellite-handshake-36" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="728" as="sourcePoint"/><mxPoint x="555" y="838" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="service-satellite-handshake-37" value="" style="edgeStyle=none;rounded=0;strokeColor=#C6343C;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="866" as="sourcePoint"/><mxPoint x="1325" y="300" as="targetPoint"/><Array as="points"><mxPoint x="1752" y="866"/><mxPoint x="1752" y="266"/><mxPoint x="1325" y="266"/></Array></mxGeometry></mxCell>
        <mxCell id="service-satellite-handshake-38" value="never" style="rounded=1;arcSize=50;fillColor=#FDFCF9;strokeColor=#C6343C;strokeWidth=2;fontColor=#A3262E;fontStyle=1;fontSize=18;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1378" y="851" width="84" height="30" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-39" value="would deadlock: Ready needs ConfigProjected," style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=center;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1203" y="889" width="434" height="28" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-40" value="which needs this step" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=center;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1316.5" y="915" width="207" height="28" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-41" value="{sat}: a GlanceBackend, CinderBackend, CinderBackupBackend, BarbicanSecretStore or KeystoneIdentityBackend. {svc}: the service resource it names." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1004" width="1372" height="28" as="geometry"/></mxCell>
        <mxCell id="service-satellite-handshake-42" value="On a KeystoneIdentityBackend the gate is DomainReady, and ConfigProjected also waits until the rollout has finished." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1066" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
