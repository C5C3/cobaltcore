        <mxCell id="service-barbican-secret-stores-86" value="{cp}, {ns}: the ControlPlane and the namespace of its Barbican. {credentials}, {ca}: the two Secrets the external block names. {mount}: its kvMountpoint, barbican by default." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="1675" height="28" as="geometry"/></mxCell>
        <mxCell id="service-barbican-secret-stores-87" value="One Barbican takes one OpenBao store, so a ControlPlane runs one of the two panels." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1326" width="852" height="28" as="geometry"/></mxCell>
        <mxCell id="service-barbican-secret-stores-88" value="A standalone BarbicanSecretStore has the same two modes; its OpenBaoCluster is then yours." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1352" width="933" height="28" as="geometry"/></mxCell>
        <mxCell id="service-barbican-secret-stores-89" value="The management OpenBao asks every client for a certificate, which the vault plugin of Barbican cannot present. It is no server for an external store." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1378" width="1439" height="28" as="geometry"/></mxCell>
