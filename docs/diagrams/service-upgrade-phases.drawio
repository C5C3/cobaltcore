        <mxCell id="service-upgrade-phases-102" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="1810" as="sourcePoint"/><mxPoint x="580" y="2020" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="service-upgrade-phases-103" value="the release or the image does not pass the gate" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#2B3440;align=right;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="43" y="1888" width="521" height="30" as="geometry"/></mxCell>
        <mxCell id="service-upgrade-phases-104" value="Database step, on every pass" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=right;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="287" y="1918" width="277" height="24" as="geometry"/></mxCell>
        <mxCell id="service-upgrade-phases-105" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="2020" as="sourcePoint"/><mxPoint x="680" y="1810" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="service-upgrade-phases-106" value="the spec is corrected" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#2B3440;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="696" y="1888" width="237" height="30" as="geometry"/></mxCell>
        <mxCell id="service-upgrade-phases-107" value="a person" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="696" y="1918" width="90" height="24" as="geometry"/></mxCell>
        <mxCell id="service-upgrade-phases-108" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="1810" as="sourcePoint"/><mxPoint x="1170" y="2020" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="service-upgrade-phases-109" value="the Job used up its retries" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#2B3440;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1186" y="1888" width="292" height="30" as="geometry"/></mxCell>
        <mxCell id="service-upgrade-phases-110" value="Database step" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1186" y="1918" width="141" height="24" as="geometry"/></mxCell>
        <mxCell id="service-upgrade-phases-111" value="From the end of the Job until the last old pod stops, the old release serves the new schema." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="59" y="2156" width="833" height="28" as="geometry"/></mxCell>
        <mxCell id="service-upgrade-phases-112" value="{name}: the service resource. The spec release is spec.image.tag on a Keystone and spec.openStackRelease on the others." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="2232" width="1114" height="28" as="geometry"/></mxCell>
        <mxCell id="service-upgrade-phases-113" value="The phases report DatabaseReady=False with ExpandInProgress, MigrateInProgress, UpgradeRollingUpdate and ContractInProgress." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="2258" width="1209" height="28" as="geometry"/></mxCell>
        <mxCell id="service-upgrade-phases-114" value="Glance, Cinder, Nova and Neutron also hold with ImageReleaseMismatch while spec.image names another release than spec.openStackRelease." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="2284" width="1308" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
