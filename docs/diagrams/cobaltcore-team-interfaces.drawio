        <mxCell id="teams-95" value="Add a hypervisor" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=26;fontStyle=1;fontColor=#17202B;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1012" width="210" height="36" as="geometry"/></mxCell>
        <mxCell id="teams-96" value="The compute team labels a node. The pool registers it in Nova, and hvo adds it to the aggregate of its zone." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1054" width="560" height="93.6" as="geometry"/></mxCell>
        <mxCell id="teams-97" value="Maintain a hypervisor" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=26;fontStyle=1;fontColor=#17202B;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="1012" width="267" height="36" as="geometry"/></mxCell>
        <mxCell id="teams-98" value="The compute team sets spec.maintenance on the node's Hypervisor. hvo disables the host in Nova and live-migrates its servers." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="1054" width="560" height="93.6" as="geometry"/></mxCell>
        <mxCell id="teams-99" value="Rotate a credential" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=26;fontStyle=1;fontColor=#17202B;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1240" y="1012" width="237" height="36" as="geometry"/></mxCell>
        <mxCell id="teams-100" value="The ControlPlane rewrites the compute contract on every compute cluster in place. Nobody hands the new values over." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1240" y="1054" width="560" height="93.6" as="geometry"/></mxCell>
