        <mxCell id="ci-stage-overview-94" value="A label is a job of .github/workflows/ci.yaml, under its key. A box holds the jobs of one stage, and a frame the stages of one event." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1176" width="1169" height="28" as="geometry"/></mxCell>
        <mxCell id="ci-stage-overview-95" value="An arrow says that a job of the stage at its tip needs a job of the stage at its tail. The job table on the page lists every needs entry." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="1162" height="28" as="geometry"/></mxCell>
        <mxCell id="ci-stage-overview-96" value="From the image build on, a job starts when the image build succeeded and none of the jobs it needs failed or was cancelled. A gate that was skipped holds nothing back." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1244" width="1515" height="28" as="geometry"/></mxCell>
