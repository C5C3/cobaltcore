        <mxCell id="ci-service-image-build-76" value="A grey box with square corners is a file or a directory. An arrow runs from what is read to the step or stage that reads it." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1322" width="1073" height="28" as="geometry"/></mxCell>
        <mxCell id="ci-service-image-build-77" value="The Dockerfile reads no file of releases/, patches/ or overrides/ by path. The two contexts and the three build args carry them in." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1356" width="1159" height="28" as="geometry"/></mxCell>
        <mxCell id="ci-service-image-build-78" value="nova has a third stage, novnc, on python-base. It fetches the pinned noVNC tree, and the runtime stage copies it." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="1020" height="28" as="geometry"/></mxCell>
