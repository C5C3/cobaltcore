        <mxCell id="service-cinder-nfs-mounts-60" value="/var/lib/nova/mnt/{md5}" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#2B3440;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1282" y="492" width="229" height="24" as="geometry"/></mxCell>
        <mxCell id="service-cinder-nfs-mounts-61" value="Bidirectional through /var/lib/nova:" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1282" y="528" width="336" height="28" as="geometry"/></mxCell>
        <mxCell id="service-cinder-nfs-mounts-62" value="QEMU on the host sees the mount" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1282" y="554" width="342" height="28" as="geometry"/></mxCell>
        <mxCell id="service-cinder-nfs-mounts-63" value="OS_DEFAULT__TRANSPORT_URL" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#2B3440;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="143.38" y="150" width="365" height="24" as="geometry"/></mxCell>
        <mxCell id="service-cinder-nfs-mounts-64" value="OS_DATABASE__CONNECTION" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#2B3440;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="812" y="214" width="338" height="24" as="geometry"/></mxCell>
        <mxCell id="service-cinder-nfs-mounts-65" value="{cinder}: the Cinder resource, {cp}-cinder under a ControlPlane. {b1}, {b2}: two CinderBackends. {bk}: the CinderBackupBackend. {md5}: the MD5 of server:path." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="1567" height="28" as="geometry"/></mxCell>
        <mxCell id="service-cinder-nfs-mounts-66" value="Every export in a Cinder pod is an inline CSI volume of the driver nfs.csi.k8s.io: the kubelet mounts it, no pod is privileged." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1326" width="1191" height="28" as="geometry"/></mxCell>
        <mxCell id="service-cinder-nfs-mounts-67" value="The backup pod mounts an export two backends share once." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1352" width="600" height="28" as="geometry"/></mxCell>
        <mxCell id="service-cinder-nfs-mounts-68" value="Locks are files under /var/lib/cinder, an emptyDir per pod (tooz file driver). Memcached holds the cache of validated tokens and nothing else." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1378" width="1369" height="28" as="geometry"/></mxCell>
