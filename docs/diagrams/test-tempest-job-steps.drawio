<mxfile host="drawio" type="device">
  <diagram id="test-tempest-job-steps" name="The commands of one tempest job in CI, in the order they run">
    <mxGraphModel dx="1608" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1608" pageHeight="1000" background="#F6F5F1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="test-tempest-job-steps-1" value="hack/nix-lock.sh" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=1;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="60" width="348" height="56" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-2" value="1" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="72" width="32" height="32" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-3" value="locks releases/&lt;release&gt;/test-refs.yaml into nix/locks/&lt;release&gt;/tempest/" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="61" width="736" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-4" value="(tempest and the four plugin pins, committed)" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="87" width="432" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-5" value="build-e2e-images job" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=1;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="165" width="348" height="56" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-6" value="2" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="177" width="32" height="32" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-7" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="274" y="116" as="sourcePoint"/><mxPoint x="274" y="165" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="test-tempest-job-steps-8" value="per release: hack/ci-nix-build-e2e-images.sh runs" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="153" width="498" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-9" value="nix build .#tempest-&lt;rel_&gt;-image in the nixos/nix container, then" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="179" width="630" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-10" value="docker load &lt; .nix-e2e/tempest-&lt;release&gt;.tar" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="205" width="441" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-11" value="hack/ci-run-tempest.sh" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=1;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="335" width="348" height="56" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-12" value="3" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="347" width="32" height="32" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-13" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="274" y="221" as="sourcePoint"/><mxPoint x="274" y="335" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="test-tempest-job-steps-14" value="per matrix.service and matrix.release:" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="271" width="362" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-15" value="1. kubectl get secret keystone-admin -n openstack (the admin password)" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="297" width="702" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-16" value="2. kubectl port-forward svc/&lt;service-k8s-name&gt; -n openstack 5000:5000, plus one" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="323" width="807" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-17" value="   forward per &lt;SERVICE&gt;_K8S_NAME the leg sets; each polled on localhost, 10 attempts" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="349" width="853" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-18" value="3. sed renders tempest.conf (localhost:5000 and the password) into _output/tempest/config;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="375" width="881" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-19" value="   exclude-tests.txt and the runner scripts are copied there" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="401" width="558" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-20" value="4. include-tests.txt is split into phases/phase-1-core.txt and phases/phase-2-plugin.txt" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="427" width="858" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-21" value="docker run" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=1;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="531" width="348" height="56" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-22" value="4" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="543" width="32" height="32" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-23" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="274" y="391" as="sourcePoint"/><mxPoint x="274" y="531" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="test-tempest-job-steps-24" value="--rm --network host, one --add-host pair per forwarded Service" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="493" width="618" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-25" value="(&lt;name&gt;.openstack.svc.cluster.local and &lt;name&gt;.openstack.svc to 127.0.0.1)," style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="519" width="750" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-26" value="-v _output/tempest/config:/etc/tempest:ro, -v _output/tempest:/output," style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="545" width="697" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-27" value="-e TEMPEST_CONCURRENCY, TEMPEST_GROUP_START, TEMPEST_GROUP_END, TEMPEST_ERROR_PREFIX" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="571" width="1080" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-28" value="ghcr.io/c5c3/tempest:&lt;release&gt; bash /etc/tempest/run-tests.sh" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="597" width="625" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-29" value="run-tests.sh" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=1;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="714" width="348" height="56" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-30" value="5" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="726" width="32" height="32" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-31" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="274" y="587" as="sourcePoint"/><mxPoint x="274" y="714" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="test-tempest-job-steps-32" value="tempest init . and cp tempest.conf etc/" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="663" width="374" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-33" value="stestr run --include-list phases/phase-1-core.txt --subunit &gt; /output/phase-1-core.subunit" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="689" width="895" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-34" value="stestr run --include-list phases/phase-2-plugin.txt --subunit &gt; /output/phase-2-plugin.subunit" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="715" width="931" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-35" value="cat both &gt; tempest.subunit; subunit2junitxml &lt; tempest.subunit &gt; tempest-results.xml" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="741" width="817" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-36" value="extract-failed.py lists the failed tests; stestr run --include-list retry-list.txt --concurrency 1" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="767" width="886" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-37" value="merge-retry-junit.py rewrites the resolved failures in tempest-results.xml" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="793" width="703" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-38" value="actions/upload-artifact" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=1;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="858" width="348" height="56" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-39" value="6" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="870" width="32" height="32" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-40" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=block;endFill=1;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="274" y="770" as="sourcePoint"/><mxPoint x="274" y="858" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="test-tempest-job-steps-41" value="tempest-&lt;service&gt;-&lt;release&gt;-results, 14-day retention" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="872" width="534" height="28" as="geometry"/></mxCell>
        <mxCell id="test-tempest-job-steps-42" value="The runner scripts never inline the steps of run-tests.sh: CI and local runs share that one code path." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="944" width="956" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
