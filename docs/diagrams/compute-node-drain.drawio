        <mxCell id="compute-node-drain-52" value="7" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1148" y="912" width="36" height="36" as="geometry"/></mxCell>
