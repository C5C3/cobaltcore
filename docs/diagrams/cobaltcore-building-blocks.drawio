        <mxCell id="blocks-94" value="+ service" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=28;fontStyle=1;fontColor=#1D47A6;align=center;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="817.0" width="121" height="38" as="geometry"/></mxCell>
        <mxCell id="blocks-95" value="" style="edgeStyle=none;rounded=0;strokeColor=#2F8A57;strokeWidth=3;endArrow=block;endFill=1;dashed=1;dashPattern=3 2;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="836" as="sourcePoint"/><mxPoint x="320" y="836" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blocks-96" value="Horizon and Placement attach no backends. A new service brings an operator of its own and one more block in spec.services; a service from outside registers with a KeystoneService." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="584" y="796" width="1216" height="62.4" as="geometry"/></mxCell>
        <mxCell id="blocks-97" value="" style="rounded=1;absoluteArcSize=1;arcSize=0;fillColor=#D5D9DE;strokeColor=none;strokeWidth=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="932" width="1760" height="2" as="geometry"/></mxCell>
        <mxCell id="blocks-98" value="Attach" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=26;fontStyle=1;fontColor=#17202B;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="956" width="85" height="36" as="geometry"/></mxCell>
        <mxCell id="blocks-99" value="Apply a CR that names the service, or add an entry to the ControlPlane. The service projects it into its config." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="998" width="560" height="93.6" as="geometry"/></mxCell>
        <mxCell id="blocks-100" value="Detach" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=26;fontStyle=1;fontColor=#17202B;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="956" width="90" height="36" as="geometry"/></mxCell>
        <mxCell id="blocks-101" value="Delete the CR, or drop the entry. The service renders its config without it." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="998" width="560" height="62.4" as="geometry"/></mxCell>
        <mxCell id="blocks-102" value="Scale" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=26;fontStyle=1;fontColor=#17202B;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1240" y="956" width="70" height="36" as="geometry"/></mxCell>
        <mxCell id="blocks-103" value="spec.sizing sets replicas and resources per component and can autoscale the APIs. More pools, backends and ControlPlanes add capacity." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1240" y="998" width="560" height="93.6" as="geometry"/></mxCell>
