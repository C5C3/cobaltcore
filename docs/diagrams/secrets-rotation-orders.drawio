<mxfile host="drawio" type="device">
  <diagram id="secrets-rotation-orders" name="Rotation of an ordered credential">
    <mxGraphModel dx="1808" dy="1172" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1808" pageHeight="1172" background="#F6F5F1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="secrets-rotation-orders-1" value="1" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="682" y="42" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-2" value="the operator creates N+1; the Secret still holds N, which stays valid" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="732" y="46" width="614" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-3" value="2" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="742" y="90" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-4" value="the backend holds N+1: status.credentialGeneration reads N+1," style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="792" y="94" width="586" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-5" value="the Secret is rewritten once the backup holds the new document," style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="792" y="120" width="596" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-6" value="previousCredentialID names N" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="792" y="146" width="288" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-7" value="3" style="ellipse;aspect=fixed;fillColor=#17202B;strokeColor=none;fontColor=#FDFCF9;fontStyle=1;fontSize=20;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1222" y="190" width="36" height="36" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-8" value="previousCredentialDeleteAt has passed: N is deleted" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1272" y="194" width="484" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-9" value="" style="rounded=0;fillColor=#F7E8F0;strokeColor=#B0387F;strokeWidth=2;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="140" y="250" width="1100" height="44" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-10" value="&lt;span style=&quot;font-weight:600&quot;&gt;generation N, delivered&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#8A2B63;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="160" y="256" width="278" height="32" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-11" value="" style="rounded=0;fillColor=#F7E8F0;strokeColor=#B0387F;strokeWidth=2;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="700" y="314" width="1000" height="44" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-12" value="&lt;span style=&quot;font-weight:600&quot;&gt;generation N+1, delivered&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=0;fontColor=#8A2B63;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="320" width="305" height="32" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-13" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=2;endArrow=none;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="78" as="sourcePoint"/><mxPoint x="700" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="secrets-rotation-orders-14" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=2;endArrow=none;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="126" as="sourcePoint"/><mxPoint x="760" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="secrets-rotation-orders-15" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=2;endArrow=none;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="226" as="sourcePoint"/><mxPoint x="1240" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="secrets-rotation-orders-16" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=none;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="400" as="sourcePoint"/><mxPoint x="1720" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="secrets-rotation-orders-17" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=none;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="390" as="sourcePoint"/><mxPoint x="140" y="410" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="secrets-rotation-orders-18" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=none;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="390" as="sourcePoint"/><mxPoint x="700" y="410" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="secrets-rotation-orders-19" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=none;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="390" as="sourcePoint"/><mxPoint x="1180" y="410" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="secrets-rotation-orders-20" value="" style="edgeStyle=none;rounded=0;strokeColor=#3A4452;strokeWidth=3;endArrow=none;whiteSpace=wrap;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="390" as="sourcePoint"/><mxPoint x="1240" y="410" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="secrets-rotation-orders-21" value="mint of N" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=center;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="92.5" y="418" width="95" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-22" value="mint of N + interval" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=center;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="608" y="418" width="184" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-23" value="switch + grace period" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=center;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1137.5" y="418" width="205" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-24" value="the Secret switches" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=center;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="665.5" y="444" width="189" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-25" value="mint of N + interval + grace period" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=center;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1021.5" y="444" width="317" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-26" value="the expiry: the net under a deletion the operator fails to make" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=center;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="899" y="470" width="562" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-27" value="Both generations are valid between 2 and 3. A consumer reads the Secret again within the grace period, or mounts it and reconnects on change." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1299" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-28" value="Triggers: the schedule (status.nextRotation), spec.credentialGeneration or spec.passwordGeneration above the status, an expired credential, a lost secret." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="1396" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-29" value="No rotation starts while a grace period runs." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="582" width="405" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-30" value="KeystoneApplicationCredential: interval 720h, grace period 24h (defaults); N+1 is a new credential of the same user" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1050" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-31" value="RabbitMQVhost: interval 720h, grace period 24h (defaults); N+1 is a new broker user {vhost}-v{N+1}" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="646" width="908" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-32" value="" style="rounded=1;absoluteArcSize=1;arcSize=26;fillColor=#EEF0F3;strokeColor=#7D8794;strokeWidth=2;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1728" height="348" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-33" value="The two kinds that rotate differently" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=26;fontStyle=1;fontColor=#2B3440;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="59" y="713" width="455" height="34" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-34" value="KeystoneUser" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#1E6B40;strokeColor=none;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=1;fontColor=#FBFAF7;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="64" y="762" width="190" height="48" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-35" value="interval 720h, no grace period (default)" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="820" width="363" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-36" value="the password of the same user is replaced, on the schedule" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="856" width="544" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-37" value="or when spec.passwordGeneration is raised" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="882" width="404" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-38" value="the old password stops when Keystone applies the new one" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="908" width="548" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-39" value="the Secret is rewritten after the backup;" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="944" width="369" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-40" value="a consumer reads it again or reconnects" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="970" width="370" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-41" value="status.lastPasswordRotation, status.nextPasswordRotation" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="996" width="545" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-42" value="MariaDBDatabase" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#1E6B40;strokeColor=none;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=24;fontStyle=1;fontColor=#FBFAF7;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="916" y="762" width="232" height="48" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-43" value="ESO draws a new user from the OpenBao lease, the Secret follows" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="916" y="820" width="608" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-44" value="the cadence is the lease's, not a field of the order" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="916" y="856" width="452" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-45" value="the database credentials figure shows the refresh and the two TTLs" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="916" y="892" width="614" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-46" value="Status fields: credentialGeneration or passwordGeneration, lastRotation, nextRotation," style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1078" width="790" height="28" as="geometry"/></mxCell>
        <mxCell id="secrets-rotation-orders-47" value="previousCredentialID or previousPasswordGeneration, previousCredentialDeleteAt or previousPasswordDeleteAt." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=20;fontStyle=0;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1104" width="1032" height="28" as="geometry"/></mxCell>
